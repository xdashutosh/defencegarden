---
// The single layout. Header, menu, enquiry modal, curtain and preloader persist across Barba navigations;
// only <main data-barba="container"> is swapped. Page <head> data is mirrored inside the container
// (<script type="application/json" data-head>) so src/lib/head-sync.js can update <head> on navigation.
import '../styles/global.css';
import Sky from '../components/chrome/Sky.astro';
import Header from '../components/chrome/Header.astro';
import Menu from '../components/chrome/Menu.astro';
import Footer from '../components/chrome/Footer.astro';
import EnquiryModal from '../components/chrome/EnquiryModal.astro';
import Preloader from '../components/chrome/Preloader.astro';
import Curtain from '../components/chrome/Curtain.astro';
import { seoFor, site } from '../lib/site.js';
import { headFor, safeJson } from '../lib/seo.js';

interface Props {
  path: string;
  namespace: string;
  title?: string;
  description?: string;
  tone?: 'dark' | 'light';     // header tone at the top of the page (dark = light text over a dark hero)
  preloader?: boolean;
  footer?: boolean;
  noindex?: boolean;
  jsonLd?: unknown;
  ogImage?: string;
}
const { path, namespace, title, description, tone = 'dark', preloader = false, footer = true, noindex = false, jsonLd, ogImage } = Astro.props;
const seo = seoFor(path, { title, description, noindex, ...(ogImage ? { ogImage } : {}) });
const head = headFor(seo, { jsonLd });
const favicons = site.brand.favicons || [];
---
<!doctype html>
<html lang={head.lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{head.title}</title>
    <meta name="theme-color" content="#061a3a" />
    <meta name="author" content={seo.author || 'Defence Garden'} />
    {seo.keywords && <meta name="keywords" content={Array.isArray(seo.keywords) ? seo.keywords.join(', ') : seo.keywords} />}
    {head.tags.map((t) => t.tag === 'meta' ? <meta {...t.attrs} data-page-head /> : <link {...t.attrs} data-page-head />)}
    {head.jsonLd && <script type="application/ld+json" data-page-head set:html={safeJson(head.jsonLd)} />}
    {favicons.map((f) => <link rel={f.rel} type={f.type} sizes={f.sizes} href={f.url} />)}
    <link rel="preload" href="/fonts/mona-sans-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Sky />
    {preloader && <Preloader />}
    <Header tone={tone} />
    <Menu />
    <div data-barba="wrapper">
      <main id="main" data-barba="container" data-barba-namespace={namespace} data-tone={tone} tabindex="-1">
        <script type="application/json" data-head set:html={safeJson(head)} />
        <slot />
        {footer && <Footer />}
      </main>
    </div>
    <EnquiryModal />
    <Curtain />
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
