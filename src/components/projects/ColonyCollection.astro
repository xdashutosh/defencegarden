---
// /ourproject — realevate category intro (hairline, centred serif headline, short text, live figures) followed by
// the filterable grid of all ten colonies and a "Booking Map Live" tile.
import ColonyCard from './ColonyCard.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import Logo from '../chrome/Logo.astro';
import { projects, displayTitle, projectUrl, sharedProjectData } from '../../lib/site.js';
import page from '../../data/pages/ourproject.json';
import { pad2 } from './util.js';

const c = page.collection;
const cities = [...new Set(projects.map((p) => p.city))];
const statuses = [...new Set(projects.map((p) => p.status))];
const countBy = (fn) => projects.filter(fn).length;
const chips = [
  { v: 'all', label: 'All', n: projects.length },
  ...['Shamli', 'Meerut', 'Budhana'].filter((x) => cities.includes(x)).map((x) => ({ v: x.toLowerCase(), label: x, n: countBy((p) => p.city === x), group: 'city' })),
  ...['Ongoing', 'Delivered'].filter((x) => statuses.includes(x)).map((x) => ({ v: x.toLowerCase(), label: x, n: countBy((p) => p.status === x), group: 'status' })),
];
const liveMaps = projects.filter((p) => p.bookingMap);
const stats = [
  { n: projects.length, label: c.pill?.[0]?.label || 'Townships' },
  { n: cities.length, label: 'Cities' },
  { n: liveMaps.length, label: c.pill?.[1]?.label || 'Live Maps' },
];
const mapBadge = sharedProjectData?.listingCard?.mapBadge || 'Booking Map Live';
const liveCities = [...new Set(liveMaps.map((p) => p.city))];
// heading "Curated Township Collection" with its accent word in italics
const accent = c.heading.accent;
const headingHtml = accent && c.heading.text.endsWith(accent)
  ? `${c.heading.text.slice(0, -accent.length).trim()} <em>${accent}</em>`
  : c.heading.text;
---
<section class="ccl t-light section" data-header-tone="light" aria-labelledby="ccl-title">
  <div class="wrap ccl__intro">
    <span class="ccl__vline" aria-hidden="true" data-reveal="clip"></span>
    <p class="eyebrow ccl__eyebrow" data-reveal="fade">The collection</p>
    <h2 class="serif ccl__title balance" id="ccl-title" data-reveal="lines" set:html={headingHtml} />
    <p class="body muted ccl__text balance" data-reveal="fade">{c.text}</p>
    <ul class="ccl__stats" data-reveal="fade">
      {stats.map((s) => (
        <li class="ccl__stat">
          <span class="ccl__num" data-counter={s.n} data-counter-pad="2">{pad2(s.n)}</span>
          <span class="eyebrow muted">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap ccl__browse" data-filter>
    <div class="ccl__bar">
      <div class="ccl__chips chips" role="group" aria-label="Filter colonies">
        {chips.map((ch, i) => (
          <>
            {i > 0 && chips[i - 1].group !== ch.group && <span class="ccl__sep" aria-hidden="true"></span>}
            <button class="chip ccl__chip" type="button" data-filter-btn={ch.v} aria-pressed={ch.v === 'all' ? 'true' : 'false'}>
              <span>{ch.label}</span><sup class="ccl__chipn">{pad2(ch.n)}</sup>
            </button>
          </>
        ))}
      </div>
      <p class="eyebrow ccl__count" aria-live="polite">Showing <span class="ccl__countn" data-filter-count>{pad2(projects.length)}</span> / {pad2(projects.length)} colonies</p>
    </div>

    <ul class="ccl__grid">
      {projects.map((p, i) => <ColonyCard p={p} n={pad2(i + 1)} filter delay={(i % 3) * 0.08} />)}
      <li class="ccl__tile t-green">
        <div class="ccl__tile-in">
          <div class="ccl__tile-copy" data-reveal="fade">
            <div class="ccl__tile-top">
              <Logo compact />
              <p class="eyebrow ccl__tile-badge"><span class="ccl__pulse" aria-hidden="true"></span>{mapBadge}</p>
            </div>
            <p class="deco deco--sm ccl__tile-title">Plots open<br />{liveCities.length === 1 ? `in ${liveCities[0]}` : 'now'}</p>
            <ul class="ccl__tile-links">
              {liveMaps.map((p) => (
                <li><a class="ccl__tile-link" href={projectUrl(p)}><span>{displayTitle(p)}</span><span class="eyebrow">{p.location} · {p.status}</span><Icon name="arrow-up-right" /></a></li>
              ))}
            </ul>
            <button class="btn ccl__tile-btn" type="button" data-enquire data-interest="Site visit"><span>Plan a site visit</span><Icon name="arrow-right" /></button>
          </div>
          <figure class="media ccl__tile-img" data-reveal="clip">
            <Img src="projects.river-green-society.gallery-02" sizes="(min-width: 1100px) 30vw, (min-width: 700px) 46vw, 92vw" widths={[480, 800, 1200]} data-parallax="0.06" />
          </figure>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .ccl { --accent: var(--green); padding-bottom: clamp(80px, 9vw, 160px); }
  .ccl__intro { display: grid; justify-items: center; text-align: center; gap: 24px; margin-bottom: clamp(70px, 9vw, 150px); }
  .ccl__vline { display: block; width: 1px; height: clamp(54px, 6vw, 96px); background: color-mix(in srgb, var(--fg) 30%, transparent); margin-bottom: 8px; }
  .ccl__eyebrow { color: var(--green); }
  .ccl__title { max-width: 14ch; }
  .ccl__title :global(em) { font-style: italic; color: var(--green); }
  .ccl__text { max-width: 44ch; }
  .ccl__stats { display: flex; justify-content: center; margin-top: 18px; border-top: 1px solid color-mix(in srgb, var(--fg) 14%, transparent); }
  .ccl__stat { display: grid; justify-items: center; gap: 6px; padding: 22px clamp(22px, 3.4vw, 56px) 0; }
  .ccl__stat + .ccl__stat { border-left: 1px solid color-mix(in srgb, var(--fg) 14%, transparent); }
  .ccl__num { font-family: var(--f-deco); font-weight: 300; font-size: clamp(38px, 3.6vw, 60px); line-height: 1; color: var(--green); }

  .ccl__bar { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-bottom: 22px; margin-bottom: clamp(28px, 3.4vw, 54px); border-bottom: 1px solid color-mix(in srgb, var(--fg) 16%, transparent); }
  .ccl__chips { align-items: center; }
  .ccl__chip { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 16px 0 18px; }
  .ccl__chip[aria-pressed='true'] { background: var(--green); border-color: var(--green); color: #fff; }
  .ccl__chipn { font-family: var(--f-wide); font-stretch: 125%; font-size: 9px; letter-spacing: .08em; opacity: .6; vertical-align: super; line-height: 0; }
  .ccl__sep { width: 1px; height: 22px; margin-inline: 8px; background: color-mix(in srgb, var(--fg) 22%, transparent); }
  .ccl__count { white-space: nowrap; color: color-mix(in srgb, var(--fg) 62%, transparent); }
  .ccl__countn { color: var(--green); font-size: 13px; }

  .ccl__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(46px, 5vw, 84px) var(--gutter); }
  .ccl__tile { grid-column: span 2; border-radius: 3px; overflow: hidden; }
  .ccl__tile-in { height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .ccl__tile-copy { display: grid; grid-template-rows: auto 1fr auto auto; gap: 26px; padding: clamp(22px, 2.6vw, 44px); justify-items: start; }
  .ccl__tile-top { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .ccl__tile-badge { display: inline-flex; align-items: center; gap: 10px; color: var(--accent); }
  .ccl__pulse { width: 7px; height: 7px; border-radius: 50%; background: #8fe0b4; box-shadow: 0 0 0 0 rgba(143,224,180,.6); animation: ccl-pulse 2.2s infinite; }
  @keyframes ccl-pulse { 0% { box-shadow: 0 0 0 0 rgba(143,224,180,.55); } 70% { box-shadow: 0 0 0 9px rgba(143,224,180,0); } 100% { box-shadow: 0 0 0 0 rgba(143,224,180,0); } }
  .ccl__tile-title { align-self: end; color: #f3f1ea; }
  .ccl__tile-links { width: 100%; border-top: 1px solid rgba(243,241,234,.25); }
  .ccl__tile-link { display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; align-items: center; padding: 14px 0; border-bottom: 1px solid rgba(243,241,234,.25); font-size: clamp(17px, 1.3vw, 21px); font-weight: 500; letter-spacing: -.02em; }
  .ccl__tile-link .eyebrow { grid-column: 1; opacity: .7; font-size: 9.5px; }
  .ccl__tile-link :global(svg) { grid-column: 2; grid-row: 1 / span 2; width: 20px; height: 20px; transition: transform .5s var(--ease-out); }
  .ccl__tile-link:hover :global(svg) { transform: translate(4px, -4px); }
  .ccl__tile-btn { --bg: var(--green); --fg: #f3f1ea; }
  .ccl__tile-img { min-height: 100%; border-radius: 0; }
  .ccl__tile-img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 1099px) {
    .ccl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ccl__tile { grid-column: 1 / -1; }
  }
  @media (max-width: 860px) {
    .ccl__bar { flex-direction: column; align-items: stretch; gap: 14px; }
    .ccl__chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .ccl__chips::-webkit-scrollbar { display: none; }
    .ccl__chip { flex: none; }
  }
  @media (max-width: 699px) {
    .ccl__grid { grid-template-columns: 1fr; gap: 54px; }
    .ccl__tile-in { grid-template-columns: 1fr; }
    .ccl__tile-img { order: -1; aspect-ratio: 16 / 10; min-height: 0; }
    .ccl__stat { padding-inline: 18px; }
  }
</style>
