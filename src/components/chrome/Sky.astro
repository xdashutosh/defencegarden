---
// Real sky at the top of every page (owner request, Oct 2026): a time-lapse of real cumulus clouds (Pexels, credited
// on /credits via src/data/vision-media.json → vision.sky-clouds) that fades down into the page. Rendered first in
// <main> by Base.astro; src/scripts/modules/sky.js moves it into the page's first section, behind that section's
// content (isolated stacking context, z-index -1), switches to faint moonlit clouds on dark first sections and plays
// the loop only while it is on screen. Reduced motion: the still first frame only.
---
<div class="sky" data-sky aria-hidden="true">
  <picture>
    <source media="(orientation: portrait)" srcset="/media/sky/sky-poster-m.webp" />
    <img class="sky__still" src="/media/sky/sky-poster.webp" alt="" decoding="async" />
  </picture>
  <video class="sky__film" muted playsinline loop preload="none" data-src="/media/sky/sky.mp4" data-src-mobile="/media/sky/sky-m.mp4"></video>
</div>

<style is:global>
  /* the section the sky moves into: its background paints first, then the sky, then all of its content */
  .has-sky { isolation: isolate; }
  .sky {
    position: absolute; top: 0; left: 0; right: 0; z-index: -1;
    height: var(--sky-h, 78vh); max-height: 100%;
    overflow: hidden; pointer-events: none;
    opacity: 0; transition: opacity 1.6s ease;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 34%, rgba(0, 0, 0, .62) 60%, rgba(0, 0, 0, .2) 82%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 0%, #000 34%, rgba(0, 0, 0, .62) 60%, rgba(0, 0, 0, .2) 82%, transparent 100%);
  }
  main > .sky { visibility: hidden; } /* until sky.js has placed it */
  .sky.is-on { opacity: 1; }
  .sky__still, .sky__film { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; }
  .sky__film { opacity: 0; transition: opacity 1.2s ease; }
  .sky__film.is-playing { opacity: 1; }
  /* dark first sections: the same sky as faint moonlit clouds over the navy / green */
  .sky--dark { mix-blend-mode: screen; }
  .sky--dark.is-on { opacity: .42; }
  .sky--dark .sky__still, .sky--dark .sky__film { filter: grayscale(.55) brightness(.62) contrast(1.35); }
  @media (max-width: 860px) { .sky { --sky-h: 66vh; } }
  @media (prefers-reduced-motion: reduce) { .sky__film { display: none; } }
</style>
