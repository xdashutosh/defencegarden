---
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Ornament from '../ui/Ornament.astro';
import { site, phone, telHref, email, office, hours } from '../../lib/site.js';

const links = [
  { n: '01', label: 'Home', href: '/', src: 'projects.river-green-society.gallery-11' },
  { n: '02', label: 'The Vision', href: '/vision', vision: 'skyline-dusk', src: 'about.r3' },
  { n: '03', label: 'Our Colonies', href: '/ourproject', src: 'projects.defence-garden-phase-1.gallery-06' },
  { n: '04', label: 'About', href: '/about', src: 'about.r3' },
  { n: '05', label: 'Gallery', href: '/gallery', src: 'projects.defence-garden-phase-2.gallery-06' },
  { n: '06', label: 'Investment', href: '/investment', src: 'about.r4' },
  { n: '07', label: 'Contact', href: '/contact', src: 'projects.defence-garden-phase-2.gallery-03' },
];
const sales = phone('sales');
const officeNo = phone('office');
---
<div class="menu t-night" id="site-menu" data-menu aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site menu">
  <Ornament variant="fan" class="menu__orn" />
  <div class="menu__in">
    <nav class="menu__nav" aria-label="Site">
      <ul>
        {links.map((l, i) => (
          <li class="menu__item" style={`--i:${i}`}>
            <a href={l.href} data-menu-link data-menu-index={i} data-nav={l.href}>
              <span class="menu__n eyebrow">{l.n}</span>
              <span class="menu__label">{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="menu__media hide-mob" aria-hidden="true">
      {links.map((l, i) => (
        <div class="menu__frame" data-menu-frame={i}>
          <Img src={l.src} vision={l.vision} sizes="34vw" widths={[480, 800, 1200]} alt="" />
        </div>
      ))}
    </div>
    <div class="menu__foot">
      <div>
        <p class="eyebrow eyebrow--accent">Sales</p>
        <a class="menu__contact" href={telHref('sales')}>{sales.display}</a>
      </div>
      <div>
        <p class="eyebrow eyebrow--accent">Office</p>
        <a class="menu__contact" href={telHref('office')}>{officeNo.display}</a>
      </div>
      <div>
        <p class="eyebrow eyebrow--accent">Write</p>
        <a class="menu__contact" href={email.href}>{email.address}</a>
      </div>
      <div class="hide-mob">
        <p class="eyebrow eyebrow--accent">Visit · {hours.display}</p>
        <p class="menu__contact menu__addr">{office.display}</p>
      </div>
      <button class="btn btn--copper menu__enquire" type="button" data-enquire><Icon name="whatsapp" /><span>Enquire on WhatsApp</span></button>
    </div>
  </div>
</div>

<style>
  .menu { position: fixed; inset: 0; z-index: 58; display: grid; overflow: hidden; visibility: hidden; clip-path: inset(0 0 100% 0); }
  .menu__orn { position: absolute; inset: -10% -5%; width: 110%; height: 120%; color: var(--copper); opacity: .14; pointer-events: none; }
  .menu__in { position: relative; display: grid; grid-template-columns: 1.15fr .85fr; grid-template-rows: 1fr auto; gap: 0 var(--gutter); padding: calc(var(--header-h) + 3vh) var(--gutter) var(--gutter); height: 100%; }
  .menu__nav ul { display: grid; gap: clamp(2px, .6vh, 10px); }
  .menu__item a { display: inline-flex; align-items: baseline; gap: 18px; padding: .1em 0; transition: color .4s; }
  .menu__label { font-family: var(--f-sans); font-weight: 500; font-size: clamp(38px, 5.1vw, 92px); line-height: 1; letter-spacing: -.04em; }
  .menu__n { color: var(--copper); min-width: 2.4em; }
  .menu__nav:hover .menu__item a { color: color-mix(in srgb, #f4ede6 38%, transparent); }
  .menu__nav .menu__item a:hover, .menu__nav .menu__item a:focus-visible { color: #f4ede6; }
  .menu__item a[aria-current='page'] .menu__label { color: var(--copper); }
  .menu__media { position: relative; align-self: center; justify-self: end; width: min(100%, 30vw); aspect-ratio: 4 / 5; }
  .menu__frame { position: absolute; inset: 0; opacity: 0; transform: scale(1.06); transition: opacity .7s var(--ease-out), transform 1.2s var(--ease-out); overflow: hidden; }
  .menu__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .menu__frame.is-on { opacity: 1; transform: none; }
  .menu__foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: end; gap: 18px clamp(24px, 4vw, 64px); padding-top: 24px; border-top: 1px solid rgba(244,237,230,.16); }
  .menu__contact { display: block; margin-top: 6px; font-size: 15px; }
  .menu__addr { max-width: 30ch; font-size: 13px; opacity: .8; }
  .menu__enquire { margin-left: auto; }
  @media (max-width: 860px) {
    .menu__in { grid-template-columns: 1fr; }
    .menu__label { font-size: clamp(34px, 10vw, 54px); }
    .menu__enquire { margin-left: 0; }
  }
</style>
