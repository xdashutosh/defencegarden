---
// Every full load of the home page: realevate's opening, rebuilt.
//  · navy screen; a square frame (the hero frame's size) at the centre where four images open one after another
//    from their centre (clip 50% → 0, image 1.5 → 1, every 0.5 s);
//  · a two-digit odometer counter at the bottom rolls 27 → 42 → 68 → 92 → 99;
//  · the last image is the hero film's first frame on a full-screen layer clipped to the square; the counter rolls
//    away, the navy wipes off bottom-to-top and the frame glides onto the hero's frame — one continuous image.
// Script: src/scripts/chrome/preloader.js. Skipped for reduced motion.
import { Image } from 'astro:assets';
import Img from '../ui/Img.astro';
import { visionVideo } from '../../lib/vision.js';
import { media } from '../../lib/media.js';

const frames = [
  { src: 'projects.river-green-society.gallery-02' },
  { vision: 'towers-modern', src: 'about.r3' },
  { src: 'about.r4' },
  { src: 'projects.defence-garden-phase-2.gallery-06' },
];
// the hero's first frame: concept film poster, else Defence Garden's own aerial (same fallback as the hero)
const film = visionVideo('hero-film');
const finalImage = film?.poster || media('about.r3').image;
const finalWidth = Math.min(1920, Number(film?.width) || 1600);
const digits = Array.from({ length: 10 }, (_, i) => i);
---
<div class="pre" data-preloader aria-hidden="true">
  <div class="pre__bg" data-pre-bg></div>
  <div class="pre__frames" data-pre-frames>
    {frames.map((f, i) => (
      <div class="pre__frame" data-pre-frame>
        <Img src={f.src} vision={f.vision} sizes="380px" widths={[320, 480, 760]} eager={i < 2} alt="" />
      </div>
    ))}
  </div>
  <div class="pre__final" data-pre-final>
    <Image src={finalImage} alt="" widths={[960, 1440, finalWidth]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={78} />
  </div>
  <div class="pre__counter" aria-hidden="true">
    <div class="pre__mask" data-pre-mask>
      <div class="pre__digits" data-pre-digits>
        <div class="pre__digit"><div class="pre__inner" data-pre-tens>{digits.map((d) => <span>{d}</span>)}</div></div>
        <div class="pre__digit"><div class="pre__inner" data-pre-ones>{digits.map((d) => <span>{d}</span>)}</div></div>
      </div>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    // like realevate: plays on every full load of the home page (never for reduced motion)
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add(reduce ? 'pre-skip' : 'pre-run');
  })();
</script>
<style>
  .pre { --pre-w: clamp(170px, 19vw, 380px); position: fixed; inset: 0; z-index: 100; pointer-events: none; }
  html:not(.pre-run) .pre { display: none; }
  html.pre-run body { overflow: hidden; }
  html.pre-run .hdr__bar, html.pre-run .dock { visibility: hidden; }
  .pre__bg { position: absolute; inset: 0; background: var(--navy); clip-path: inset(0 0 0 0); }
  .pre__frames { position: absolute; left: 50%; top: 50%; width: var(--pre-w); height: var(--pre-w); transform: translate(-50%, -50%); overflow: hidden; }
  .pre__frame { position: absolute; inset: 0; overflow: hidden; clip-path: inset(50% 50% 50% 50%); }
  .pre__frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transform-origin: center; }
  .pre__final { position: absolute; inset: 0; clip-path: inset(50% 50% 50% 50%); }
  .pre__final :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; transform: scale(1.3); transform-origin: center; }
  .pre__counter { --d: clamp(15px, 1.65vw, 30px); position: absolute; left: 50%; bottom: max(6.5vh, 2.5rem); transform: translateX(-50%); color: #fff; }
  .pre__mask { overflow: hidden; height: var(--d); line-height: 1; }
  .pre__digits { display: flex; gap: .02em; transform: translateY(100%); }
  .pre__digit { width: .62em; height: var(--d); overflow: hidden; font-family: var(--f-sans); font-weight: 500; font-size: var(--d); line-height: 1; font-variant-numeric: tabular-nums; }
  .pre__inner { display: flex; flex-direction: column; }
  .pre__inner span { display: flex; align-items: center; justify-content: center; height: var(--d); flex: 0 0 var(--d); }
  @media (max-width: 860px) { .pre { --pre-w: 40vw; } .pre__counter { --d: 5.5vw; bottom: max(8vh, 2rem); } }
  @media (prefers-reduced-motion: reduce) { .pre { display: none !important; } }
</style>
