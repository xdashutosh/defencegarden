---
// Wordmark: spaced wide capitals (realevate) with Defence Garden's sprout redrawn as a one-colour mark.
interface Props { class?: string; compact?: boolean }
const { class: cls = '', compact = false } = Astro.props;
---
<span class={`logo ${compact ? 'logo--compact' : ''} ${cls}`}>
  <span class="logo__word">Defence</span>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
    <path d="M16.4 29.5c-.6-5.6.2-10.3 2.3-14 2.4-4.3 6.3-6.9 10.8-7.6-.8 5.3-3.3 9.3-7.6 11.3-2 .9-3.7 2.6-4.6 5.6l-.9 4.7Z"/>
    <path d="M15.2 21.4c-3.4-1.2-6.4-3.8-7.8-8.4 4.1.1 7.3 2.1 8.9 5.5l-1.1 2.9Z" opacity=".78"/>
  </svg>
  <span class="logo__word">Garden</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: .55em; font-family: var(--f-wide); font-stretch: 125%; font-weight: 600; font-size: 13px; letter-spacing: .32em; text-transform: uppercase; line-height: 1; white-space: nowrap; }
  .logo__word:last-child { margin-right: -.32em; }
  .logo__mark { width: 1.7em; height: 1.7em; color: var(--accent, #cf8f7d); flex: none; }
  .logo--compact .logo__word { display: none; }
  .logo--compact .logo__mark { width: 28px; height: 28px; }
  @media (max-width: 520px) { .logo { font-size: 11px; letter-spacing: .26em; } }
</style>
