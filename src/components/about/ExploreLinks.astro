---
// Explore links as realevate-style framed cards (real Defence Garden photographs, numbered, arrow on hover).
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
interface Link { label: string; href: string; img: string }
interface Props { links: Link[]; ariaLabel: string; eyebrow?: string; heading?: string; theme?: string; class?: string }
const { links, ariaLabel, eyebrow, heading, theme = 't-ivory', class: cls = '' } = Astro.props;
const dark = theme === 't-night' || theme === 't-green';
// "Defence Garden" never breaks over two lines: odd parts go in a .nowrap span (a U+00A0 would not survive SplitText)
const title = heading ? heading.split(/(Defence Garden)/) : [];
---
<nav class={`exl ${theme} section section--tight ${cls}`} data-header-tone={dark ? 'dark' : 'light'} aria-label={ariaLabel}>
  <div class="wrap">
    {(eyebrow || heading) && (
      <div class="exl__head">
        {eyebrow && <p class="eyebrow eyebrow--accent" data-reveal="fade">{eyebrow}</p>}
        {heading && <p class="display exl__title" data-reveal="lines">{title.map((s, i) => (i % 2 ? <span class="nowrap">{s}</span> : s))}</p>}
      </div>
    )}
    <ul class="exl__grid">
      {links.map((l, i) => (
        <li data-reveal="fade" data-reveal-delay={(i * 0.08).toFixed(2)}>
          <a class="exl__card" href={l.href}>
            <div class="exl__img media"><Img src={l.img} sizes="(min-width: 861px) 30vw, 92vw" widths={[480, 800, 1200]} /></div>
            <div class="exl__meta">
              <span class="deco deco--sm exl__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="exl__label">{l.label}</span>
              <span class="btn-square exl__go" aria-hidden="true"><Icon name="arrow-up-right" class="ico" /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
<style>
  .exl__head { display: grid; gap: 18px; margin-bottom: clamp(30px, 4vw, 64px); }
  .exl__title { font-size: clamp(38px, 4.6vw, 84px); }
  .exl__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .exl__card { display: grid; gap: 16px; }
  .exl__img { aspect-ratio: 16 / 11; }
  .exl__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.3s var(--ease-out); }
  .exl__card:hover .exl__img :global(img) { transform: scale(1.05); }
  .exl__meta { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding-top: 14px; border-top: 1px solid color-mix(in srgb, var(--fg) 18%, transparent); }
  .exl__n { color: var(--accent); line-height: 1; }
  .exl__label { font-size: clamp(19px, 1.6vw, 26px); font-weight: 500; letter-spacing: -.02em; line-height: 1.1; }
  .exl__go { transition: background .4s, color .4s, transform .6s var(--ease-out); }
  .exl__card:hover .exl__go { background: var(--accent); color: var(--navy-deep); transform: rotate(45deg); }
  @media (max-width: 860px) {
    .exl__grid { grid-template-columns: 1fr; gap: 28px; }
    .exl__img { aspect-ratio: 16 / 9; }
  }
</style>
