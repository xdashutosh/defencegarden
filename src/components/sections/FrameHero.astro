---
// Realevate hero (giant marquee line with a framed image/video at its centre) that expands on scroll into an
// era.estate full-bleed scene with an overlay title. Reused by Home, Vision, Colonies and project pages.
import Img from '../ui/Img.astro';
import Vid from '../ui/Vid.astro';
import Icon from '../ui/Icon.astro';
import Ornament from '../ui/Ornament.astro';
import { getImage } from 'astro:assets';
import { vision as getVision, visionVideo as getVisionVideo } from '../../lib/vision.js';
import { media, preferred } from '../../lib/media.js';

interface Cta { label: string; href?: string; enquire?: boolean; interest?: string; colony?: string; solid?: boolean }
interface Props {
  words: string;                 // marquee line
  theme?: string;                // t-light | t-ivory | t-green | t-night …
  tone?: 'light' | 'dark';       // header tone over the marquee part
  eyebrow?: string;              // small label bottom-left
  sub?: string;                  // centred line under the marquee
  note?: string;                 // small boxed label under the sub (realevate "STARTING FROM …")
  ctas?: Cta[];
  image?: unknown;               // DG media (key / data object)
  vision?: string;               // concept image key
  video?: unknown;               // DG video key / data object
  visionVideo?: string;          // concept film key
  concept?: boolean;             // show the "Concept visualisation" tag on the media
  overlayEyebrow?: string;
  overlayTitle?: string;         // big .deco title once full screen
  overlayText?: string;
  frameW?: string;               // frame size (CSS length) — default responsive
  frameH?: string;
  alt?: string;
  scrub?: boolean;               // scroll drives the film's time (scrubVideo module) instead of autoplay
  beats?: Beat[];                // story beats over the full-screen film, each visible over a scroll range
  length?: number;               // section height in vh (desktop); scroll distance = length − 100
  lengthMobile?: number;
  expand?: number;               // fraction (0..1) of the section's scroll used to grow the frame to full screen
  start?: 'frame' | 'point';     // 'point': the media starts as a small round dot and grows from it on scroll
}
interface Beat { eyebrow?: string; title: string; text?: string; cta?: { label: string; href: string }; at: [number, number] }
const {
  words, theme = 't-light', tone = 'light', eyebrow, sub, note, ctas = [], image, vision, video, visionVideo,
  concept = false, overlayEyebrow, overlayTitle, overlayText, frameW, frameH, alt,
  scrub = false, beats = [], length, lengthMobile, expand, start = 'frame',
} = Astro.props;

// scroll-scrub film: poster (exact first frame; native 9:16 one on portrait screens — same rule as scrubVideo.js)
// under a scrubbed <video>
const scrubFilm = scrub && visionVideo ? getVisionVideo(visionVideo) : null;
let scrubPoster = null, scrubPosterMobile = null;
if (scrubFilm?.poster) scrubPoster = await getImage({ src: scrubFilm.poster, width: Math.min(1920, Number(scrubFilm.width) || 1920), format: 'webp', quality: 80 });
if (scrubFilm?.posterMobile) scrubPosterMobile = await getImage({ src: scrubFilm.posterMobile, width: 720, format: 'webp', quality: 80 });
const len = length || 260, lenM = lengthMobile || Math.round(len * 0.85);
const exp = expand ?? 1;
// header turns light-on-dark once the growing frame has reached it (~96 % grown): that scroll point inside the section
const zoneTop = (pct) => `${((0.96 * exp * (pct - 100)) / pct * 100).toFixed(2)}%`;
// The concept tag appears only when licensed concept media is actually rendered (never on DG's own photos).
const usingConcept = Boolean((visionVideo && getVisionVideo(visionVideo)) || (!visionVideo && !video && vision && getVision(vision)) || (visionVideo && !getVisionVideo(visionVideo) && !video && vision && getVision(vision)));
// The full-bleed photo (no film) is cover-cropped to the screen: on a screen narrower than the photo's aspect (portrait
// phones) it is drawn 100vh × aspect wide (a 3:2 photo ≈ 3.2 × a phone's width), so sizes says so. The record is the one
// Img renders: the concept image, else the photo (the sharper twin of a data object).
const still = visionVideo || video ? null : (vision && getVision(vision)) || (image ? (typeof image === 'object' ? preferred(image) : media(image)) : null);
const stillSizes = still?.width && still?.height ? `(max-aspect-ratio: ${still.width}/${still.height}) ${Math.round((still.width / still.height) * 100)}vh, 100vw` : '100vw';
const style = [frameW && `--fh-w:${frameW}`, frameH && `--fh-h:${frameH}`, `--fh-len:${len}vh`, `--fh-len-m:${lenM}vh`, `--fh-zone:${zoneTop(len)}`, `--fh-zone-m:${zoneTop(lenM)}`].filter(Boolean).join(';');
---
<section class={`fh ${theme}`} data-frame-hero data-scrub-root data-fh-expand={exp} data-fh-start={start} data-header-tone={tone} style={style || undefined}>
  <div class="fh__zone" data-header-tone="dark" data-header-surface="media" aria-hidden="true"></div>
  <div class="fh__sticky">
    <div class="fh__probe" data-fh-probe aria-hidden="true"></div>
    <div class="fh__ui" data-fh-ui>
      <h1 class="sr-only">{words.replace(/[—–·]+\s*$/, '').trim()}</h1>
      <div class="fh__marquee" aria-hidden="true">
        <div class="fh__track" data-marquee data-marquee-speed="55">
          <div class="fh__row" data-marquee-track>
            {[0, 1, 2, 3].map(() => <span class="marquee-type fh__word" data-fh-line>{words}&nbsp;</span>)}
          </div>
        </div>
      </div>
      <div class="fh__center">
        {sub && <p class="fh__sub balance" data-fh-sub>{sub}</p>}
        {note && <p class="fh__note" data-fh-note><span>{note}</span></p>}
      </div>
      <div class="fh__bottom">
        <p class="eyebrow fh__eyebrow" data-fh-fade>{eyebrow}</p>
        <div class="fh__ctas" data-fh-fade>
          {ctas.map((c) => c.href
            ? <a class={`btn ${c.solid ? 'btn--solid' : ''}`} href={c.href}><span>{c.label}</span><Icon name="arrow-right" /></a>
            : <button class={`btn ${c.solid ? 'btn--solid' : ''}`} type="button" data-enquire data-interest={c.interest} data-colony={c.colony}><span>{c.label}</span><Icon name="arrow-right" /></button>)}
        </div>
      </div>
    </div>
    <div class="fh__media" data-fh-media>
      {scrubFilm ? (
        <div class="fh__inner" data-fh-inner>
          <picture>
            {scrubPosterMobile && <source media="(orientation: portrait)" srcset={scrubPosterMobile.src} />}
            <img class="fh__fill" src={scrubPoster?.src} alt={alt || scrubFilm.alt} loading="eager" fetchpriority="high" decoding="async" />
          </picture>
          <video class="fh__fill fh__scrub" data-scrub data-src={scrubFilm.url} data-src-mobile={scrubFilm.urlMobile || undefined} muted playsinline preload="none" aria-hidden="true"></video>
        </div>
      ) : visionVideo || video
        ? <Vid vision={visionVideo} src={video} class="fh__fill" eager label={alt} />
        : <Img vision={vision} src={image} class="fh__fill" eager sizes={stillSizes} alt={alt} />}
      <div class="fh__shade" data-fh-shade aria-hidden="true"></div>
      {(concept || usingConcept) && usingConcept && <span class="concept-tag">Concept visualisation</span>}
    </div>
  </div>
  {(beats.length > 0 || overlayTitle || overlayText) && (
    <div class="fh__over">
      <div class="fh__overpin">
        {beats.length > 0 ? beats.map((b, i) => (
          <div class="fh__overlay fh__beat t-night" data-fh-beat={`${b.at[0]},${b.at[1]}`}>
            {i === 0 && <Ornament variant="diamond" class="fh__orn" />}
            {b.eyebrow && <p class="eyebrow eyebrow--accent">{b.eyebrow}</p>}
            <p class="deco fh__otitle" set:html={b.title} />
            {b.text && <p class="lead fh__otext balance">{b.text}</p>}
            {b.cta && <a class="btn btn--copper fh__bcta" href={b.cta.href}><span>{b.cta.label}</span><Icon name="arrow-right" /></a>}
          </div>
        )) : (
          <div class="fh__overlay t-night" data-fh-overlay>
            <Ornament variant="diamond" class="fh__orn" />
            {overlayEyebrow && <p class="eyebrow eyebrow--accent">{overlayEyebrow}</p>}
            {overlayTitle && <p class="deco fh__otitle" set:html={overlayTitle} />}
            {overlayText && <p class="lead fh__otext balance">{overlayText}</p>}
          </div>
        )}
      </div>
    </div>
  )}
</section>

<style>
  /* realevate composition: the frame and its marquee line sit at --fh-y (41% of the viewport), subtitle and boxed
     label below, small eyebrow bottom-left; actions live in the global dock (bottom-right). */
  .fh { position: relative; height: var(--fh-len, 260vh); --fh-w: clamp(170px, 19vw, 380px); --fh-h: clamp(170px, 19vw, 380px); --fh-y: 41%; }
  .fh__zone { position: absolute; left: 0; right: 0; top: var(--fh-zone, 45%); bottom: 0; pointer-events: none; }
  .fh__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .fh__probe { position: absolute; left: 50%; top: var(--fh-y); width: var(--fh-w); height: var(--fh-h); transform: translate(-50%, -50%); visibility: hidden; pointer-events: none; }
  .fh__ui { position: absolute; inset: 0; will-change: opacity; }
  .fh__marquee { position: absolute; left: 0; right: 0; top: var(--fh-y); transform: translateY(-50%); overflow: hidden; }
  .fh__row { display: flex; width: max-content; }
  /* the marquee clips its words (they rise into it in the intro): .2em of room above and below the .92 line box keeps
     the descenders (g, y, p) whole, and equal room keeps the line centred on --fh-y, the frame's centre */
  .fh__word { display: inline-block; padding-right: .18em; padding-block: .2em; }
  .fh__center { position: absolute; left: 50%; top: 72.5%; transform: translateX(-50%); width: min(92vw, 760px); display: grid; justify-items: center; gap: clamp(14px, 1.6vw, 26px); text-align: center; }
  .fh__sub { font-family: var(--f-sans); font-weight: 500; font-size: clamp(17px, 1.65vw, 30px); line-height: 1.3; letter-spacing: -.01em; max-width: 40ch; }
  .fh__note { font-family: var(--f-sans); font-weight: 500; font-size: clamp(10px, .9vw, 14px); letter-spacing: .1em; text-transform: uppercase; line-height: 1.35; }
  .fh__note span { display: inline-block; padding: .3em .7em; border: 1px solid currentColor; }
  .fh__bottom { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: end; gap: var(--gutter); padding: 0 var(--gutter) calc(var(--gutter) + 6px); }
  .fh__eyebrow { font-size: 10px; }
  .fh__ctas { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; margin-bottom: 56px; }
  .fh__ctas:empty { display: none; }
  .fh__media { position: absolute; inset: 0; z-index: 2; will-change: clip-path; clip-path: inset(calc(var(--fh-y) - var(--fh-h) / 2) calc(50% - var(--fh-w) / 2) calc(100% - var(--fh-y) - var(--fh-h) / 2)); }
  .fh[data-fh-start='point'] .fh__media { clip-path: inset(calc(var(--fh-y) - 6px) calc(50% - 6px) calc(100% - var(--fh-y) - 6px) round 6px); }
  /* layers the scroll animates are prepared up front, so the first scroll does not stall while they are created */
  .fh__inner { position: absolute; inset: 0; will-change: transform; }
  .fh__scrub { opacity: 0; transition: opacity .35s ease; }
  .fh__scrub:global(.is-painted) { opacity: 1; }
  /* beats sit on moving footage: a wider, deeper scrim than the static overlay, and lit text */
  .fh__beat { pointer-events: none; background: radial-gradient(ellipse 64% 60% at 50% 52%, rgba(6,26,58,.62), rgba(6,26,58,.3) 62%, rgba(6,26,58,.12)); }
  .fh__beat .eyebrow { color: var(--copper-soft); text-shadow: 0 1px 12px rgba(6,26,58,.7); }
  .fh__beat .fh__otext { opacity: 1; text-shadow: 0 1px 16px rgba(6,26,58,.75); }
  .fh__bcta { pointer-events: auto; margin-top: 6px; }
  .fh__media :global(.fh__fill) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  .fh__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,26,58,.35), rgba(6,26,58,.05) 40%, rgba(6,26,58,.55)); pointer-events: none; opacity: 0; }
  /* beats/overlay: their own pinned layer over the sticky stage, so with reduced motion they flow below the hero */
  .fh__over { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .fh__overpin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .fh__overlay { position: absolute; inset: 0; background: radial-gradient(ellipse 58% 52% at 50% 50%, rgba(6,26,58,.55), rgba(6,26,58,.18) 70%, transparent); display: grid; place-content: center; justify-items: center; text-align: center; gap: 22px; padding: var(--gutter); opacity: 0; visibility: hidden; color: #f4ede6; }
  .fh__orn { width: 26px; color: var(--copper); }
  .fh__otitle { max-width: 14ch; text-shadow: 0 2px 30px rgba(6,26,58,.35); }
  .fh__otext { max-width: 44ch; opacity: .92; }
  @media (max-width: 860px) {
    /* capped by the height left below the header, so on landscape phones the frame stays clear of it */
    .fh { height: var(--fh-len-m, 220vh); --fh-w: min(40vw, calc(84svh - 2 * var(--header-h) - 16px)); --fh-h: var(--fh-w); --fh-y: 42%; }
    .fh__zone { top: var(--fh-zone-m, 45%); }
    .fh__center { top: 66%; }
    .fh__sub { font-size: 17px; }
    .fh__eyebrow { display: none; }
    .fh__ctas { margin-bottom: 60px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fh { height: auto; }
    .fh__sticky { position: relative; height: auto; min-height: 100svh; }
    .fh__zone { top: 100svh; }
    .fh__over, .fh__overpin { position: relative; inset: auto; height: auto; overflow: visible; }
    .fh__overlay { position: relative; opacity: 1; visibility: visible; background: var(--navy-deep); padding-block: 80px; }
    .fh__scrub { display: none; }
  }
</style>
