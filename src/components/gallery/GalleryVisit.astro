---
// Closing band for /gallery: ivory editorial band (contrasts with the navy footer) with a deco line and a site-visit enquiry (real photo, no new claims).
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Ornament from '../ui/Ornament.astro';
---
<style is:inline>
  .gvb { position: relative; overflow: hidden; }
  .gvb__orn { position: absolute; left: 50%; top: 0; width: 130%; height: 100%; transform: translateX(-50%); color: var(--copper-deep); opacity: .08; pointer-events: none; }
  .gvb__in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(30px, 6vw, 110px); align-items: center; }
  .gvb__img { aspect-ratio: 4 / 3; }
  .gvb__img img { width: 100%; height: 100%; object-fit: cover; }
  .gvb__copy { display: grid; gap: 26px; justify-items: start; }
  .gvb__title { color: var(--fg); }
  .gvb__orn2 { width: 22px; color: var(--accent); }
  .gvb__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 860px) { .gvb__in { grid-template-columns: 1fr; } .gvb__copy { grid-row: 1; } }
</style>
<section class="gvb t-ivory section" data-header-tone="light">
  <Ornament variant="fan" class="gvb__orn" />
  <div class="wrap gvb__in">
    <figure class="gvb__img media" data-reveal="clip">
      <Img src="projects.defence-garden-phase-2.gallery-03" sizes="(min-width: 861px) 44vw, 92vw" widths={[480, 800, 1200, 1600]} data-parallax="0.06" />
    </figure>
    <div class="gvb__copy">
      <Ornament variant="diamond" class="gvb__orn2" />
      <p class="eyebrow eyebrow--accent" data-reveal="fade">See it in person</p>
      <h2 class="deco deco--sm gvb__title" data-reveal="lines">Visit a colony</h2>
      <p class="body muted" data-reveal="fade" style="max-width:46ch">Arrange a site visit with our sales team on WhatsApp.</p>
      <div class="gvb__actions" data-reveal="fade">
        <button class="btn btn--solid" type="button" data-enquire data-interest="Site visit"><Icon name="whatsapp" /><span>Book a site visit</span></button>
        <a class="btn" href="/ourproject"><span>Explore our colonies</span><Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>
