---
// Muted background video: licensed concept film (`vision` key) or a Defence Garden film (manifest key / data object).
// The runtime (src/scripts/modules/video.js) loads it only while visible (eager: at once), picks the lightest file
// that fits the box — data-src-portrait (9:16 crop) for portrait boxes, data-src-small for small landscape boxes,
// else data-src — and loops between data-start / data-end when given. Reduced motion / Save-Data: poster only.
import { getImage } from 'astro:assets';
import { video } from '../../lib/media.js';
import { visionVideo } from '../../lib/vision.js';

interface Props { vision?: string; src?: unknown; class?: string; eager?: boolean; label?: string }
const { vision, src, class: cls = '', eager = false, label } = Astro.props;

const v = vision ? visionVideo(vision) : null;
const d = !v && src ? video(src) : null;
const rec = v || d;
let poster = null;
if (rec?.poster) {
  const w = Math.min(1920, Number(rec.width) || 1920);
  poster = (await getImage({ src: rec.poster, width: w, format: 'webp', quality: 72 })).src;
}
const portrait = d?.urlPortrait || v?.urlMobile || null;
const small = d?.urlSmall || null;
const start = d?.startAt || 0;
const end = d?.endAt || 0;
---
{rec && (
  <video
    class={cls}
    data-video
    data-src={rec.url}
    data-src-portrait={portrait ?? undefined}
    data-src-small={small ?? undefined}
    data-eager={eager ? '' : undefined}
    poster={poster ?? undefined}
    muted
    playsinline
    loop={start > 0 || end > 0 ? undefined : true}
    preload="none"
    data-start={start || undefined}
    data-end={end || undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    data-concept={v ? '' : undefined}
  ></video>
)}
