---
// What the vertical chapter will be — intentions, not announced projects. Concept photography only.
import Img from '../ui/Img.astro';
const items = [
  { t: 'Residential high-rise societies', d: 'Gated towers with the community, security and planning our colonies are known for — stacked for the city.', vision: 'towers-portrait', fb: 'projects.river-green-society.gallery-09' },
  { t: 'Vertical communities', d: 'Shared gardens, play and gathering spaces lifted onto podiums, decks and rooftops.', vision: 'rooftop-garden', fb: 'projects.defence-garden-phase-1.gallery-08' },
  { t: 'Landmark towers', d: 'Taller buildings in growing urban centres, designed with architects and engineers from the ground up.', vision: 'skyline-night', fb: 'about.r3' },
];
---
<section class="typ t-night section" data-header-tone="dark">
  <div class="wrap">
    <div class="sec-head sec-head--row typ__head">
      <div class="sec-head">
        <p class="eyebrow eyebrow--accent" data-reveal="fade">What we will build</p>
        <h2 class="deco" data-reveal="lines">Homes that<br />rise with the city</h2>
      </div>
      <p class="body typ__note" data-reveal="fade">Intentions for our next chapter. Specific projects will be announced only after their approvals are in place.</p>
    </div>
    <ul class="typ__grid">
      {items.map((it, i) => (
        <li class="typ__card" data-reveal="fade" data-reveal-delay={(i * 0.1).toFixed(1)}>
          <div class="media typ__img"><Img vision={it.vision} src={it.fb} sizes="(min-width: 861px) 31vw, 92vw" data-scale-in /><span class="concept-tag">Concept</span></div>
          <p class="eyebrow eyebrow--accent">0{i + 1}</p>
          <h3 class="typ__t">{it.t}</h3>
          <p class="body muted">{it.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .typ__head { margin-bottom: clamp(36px, 5vw, 80px); }
  .typ__head .deco { color: #f4ede6; }
  .typ__note { max-width: 38ch; color: rgba(244,237,230,.75); }
  .typ__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .typ__card { display: grid; gap: 12px; align-content: start; }
  .typ__card:nth-child(2) { margin-top: clamp(0px, 6vw, 110px); }
  .typ__img { aspect-ratio: 3 / 4; margin-bottom: 8px; }
  .typ__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .typ__t { font-size: clamp(24px, 2.2vw, 38px); font-weight: 500; letter-spacing: -.03em; line-height: 1.05; color: #f4ede6; }
  @media (max-width: 860px) { .typ__grid { grid-template-columns: 1fr; } .typ__card:nth-child(2) { margin-top: 0; } }
</style>
