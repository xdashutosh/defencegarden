---
// Realevate's four colour-coded collection cards, re-cast for Defence Garden.
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../chrome/Logo.astro';
const cards = [
  { k: 'green', title: 'Legacy Townships', text: 'Ten gated, plotted colonies across Shamli, Meerut & Budhana.', href: '/ourproject', src: 'projects.river-green-society.gallery-02' },
  { k: 'navy', title: 'Urban High-Rise', text: 'Our vision for residential towers in India’s growing cities.', href: '/vision', vision: 'towers-modern', src: 'about.r3', concept: true },
  { k: 'aubergine', title: 'Invest With Us', text: 'Land-backed value, planned infrastructure, long horizons.', href: '/investment', src: 'about.r4' },
  { k: 'ink', title: 'Life in Colonies', text: 'Real photographs from our townships, unfiltered.', href: '/gallery', src: 'projects.defence-garden-phase-2.gallery-06' },
];
---
<section class="col t-mist section" data-header-tone="light">
  <div class="wrap">
    <div class="sec-head sec-head--row col__head">
      <div class="sec-head">
        <p class="eyebrow eyebrow--accent" data-reveal="fade">Explore</p>
        <h2 class="display" data-reveal="lines">Land, towers<br />and everything between</h2>
      </div>
      <a class="btn" href="/ourproject" data-reveal="fade"><span>All colonies</span><Icon name="grid" /></a>
    </div>
    <div class="col__grid" data-header-tone="dark">
      {cards.map((c, i) => (
        <a class={`col__card col__card--${c.k}`} href={c.href} data-reveal="fade" data-reveal-delay={(i * 0.08).toFixed(2)}>
          <div class="col__panel">
            <Logo compact />
            <h3 class="col__title">{c.title}</h3>
            <p class="small col__text">{c.text}</p>
          </div>
          <div class="col__img media">
            <Img src={c.src} vision={c.vision} sizes="(min-width: 861px) 24vw, 46vw" widths={[480, 800, 1200]} />
            {c.concept && <span class="concept-tag">Concept</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .col__head { margin-bottom: clamp(36px, 5vw, 80px); }
  .col__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(10px, 1.4vw, 22px); }
  .col__card { --c: var(--navy-2); display: grid; grid-template-rows: auto 1fr; color: #f3f1ea; background: var(--c); border-radius: 3px; overflow: hidden; transition: transform .8s var(--ease-out), box-shadow .8s var(--ease-out); }
  .col__card--green { --c: var(--green); }
  .col__card--navy { --c: var(--navy-2); }
  .col__card--aubergine { --c: var(--aubergine); }
  .col__card--ink { --c: var(--rare); }
  .col__card:hover { transform: translateY(-8px); box-shadow: 0 30px 60px -30px rgba(6,26,58,.5); }
  .col__panel { position: relative; padding: 18px; min-height: clamp(260px, 24vw, 420px); display: grid; grid-template-rows: auto 1fr auto; }
  .col__title { writing-mode: vertical-rl; transform: rotate(180deg); justify-self: end; align-self: end; font-family: var(--f-sans); font-weight: 500; font-size: clamp(30px, 2.8vw, 50px); letter-spacing: -.035em; line-height: 1; }
  .col__text { max-width: 22ch; opacity: .85; }
  .col__img { aspect-ratio: 5 / 4; }
  .col__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease-out); }
  .col__card:hover .col__img :global(img) { transform: scale(1.06); }
  @media (max-width: 1100px) { .col__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .col__grid { grid-template-columns: 1fr; } .col__panel { min-height: 240px; } }
</style>
