---
// What carries over from land to towers — DG's own guiding principles + amenity facts, with real photos.
import Img from '../ui/Img.astro';
const items = [
  { n: '01', t: 'Trust & Transparency', d: 'Legal clarity, ethical delivery, and open communication behind every plot we hand over.', src: 'projects.defence-garden-phase-2.gallery-03' },
  { n: '02', t: 'Future-Ready Planning', d: 'Wide roads, clear zoning, and practical amenities that create value today and confidence tomorrow.', src: 'projects.river-green-society.gallery-02' },
  { n: '03', t: 'Sustainable Living', d: 'Neighborhoods designed around trees, airflow, and open greens — so each community breathes naturally.', src: 'projects.defence-garden-phase-1.gallery-08' },
  { n: '04', t: 'Security by Design', d: 'Gated communities with 24/7 security, boundary walls and planned, well-lit streets.', src: 'projects.defence-garden-phase-2.gallery-06' },
];
---
<section class="prn t-light section" data-header-tone="light">
  <div class="wrap">
    <div class="sec-head prn__head">
      <p class="eyebrow eyebrow--accent" data-reveal="fade">What guides us</p>
      <h2 class="serif" data-reveal="lines">Principles we carry<br />from land to towers</h2>
    </div>
    <ol class="prn__list">
      {items.map((it, i) => (
        <li class="prn__item" data-reveal="fade" data-reveal-delay={(i * 0.06).toFixed(2)}>
          <span class="deco deco--sm prn__n">{it.n}</span>
          <div class="prn__copy">
            <h3 class="prn__t">{it.t}</h3>
            <p class="body muted">{it.d}</p>
          </div>
          <figure class="media prn__img"><Img src={it.src} sizes="(min-width: 861px) 22vw, 90vw" widths={[480, 800, 1200]} /></figure>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .prn__head { margin-bottom: clamp(36px, 5vw, 80px); }
  .prn__list { border-top: 1px solid color-mix(in srgb, var(--fg) 16%, transparent); }
  .prn__item { display: grid; grid-template-columns: 120px 1fr minmax(180px, 26%); gap: var(--gutter); align-items: center; padding-block: clamp(18px, 2.4vw, 34px); border-bottom: 1px solid color-mix(in srgb, var(--fg) 16%, transparent); }
  .prn__n { color: var(--accent); }
  .prn__copy { display: grid; gap: 10px; max-width: 60ch; }
  .prn__t { font-size: clamp(24px, 2.4vw, 40px); font-weight: 500; letter-spacing: -.03em; line-height: 1.05; }
  .prn__img { aspect-ratio: 16 / 10; }
  .prn__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .prn__item:hover .prn__img :global(img) { transform: scale(1.06); }
  @media (max-width: 860px) { .prn__item { grid-template-columns: 56px 1fr; } .prn__img { grid-column: 1 / -1; } }
</style>
