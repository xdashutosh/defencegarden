---
// era.estate-style navy statement: copper capitals paragraph + framed image reveal.
import Img from '../ui/Img.astro';
import Ornament from '../ui/Ornament.astro';
---
<section class="stm t-night section" data-header-tone="dark">
  <Ornament variant="fan" class="stm__orn" />
  <div class="wrap stm__in">
    <p class="eyebrow eyebrow--accent" data-reveal="fade">The next chapter</p>
    <h2 class="deco stm__title" data-reveal="lines">The new era of<br />Defence Garden</h2>
    <p class="deco--text stm__text balance" data-reveal="lines">For twenty years we have shaped land in Western Uttar Pradesh into gated, green, clearly-titled colonies. Now we are carrying the same principles upward — into residential towers for India's growing cities.</p>
    <div class="stm__frames">
      <figure class="stm__frame stm__frame--a media" data-reveal="clip">
        <Img src="projects.defence-garden-phase-1.gallery-06" sizes="(min-width: 861px) 30vw, 80vw" widths={[480, 800, 1200, 1600]} data-scale-in />
        <figcaption class="eyebrow stm__cap">Where we began · Plotted townships</figcaption>
      </figure>
      <figure class="stm__frame stm__frame--b media" data-reveal="clip" data-reveal-delay="0.15">
        <Img vision="crane-golden" src="about.r3" sizes="(min-width: 861px) 34vw, 80vw" />
        <span class="concept-tag">Concept</span>
        <figcaption class="eyebrow stm__cap">Where we are going · Urban high-rise</figcaption>
      </figure>
    </div>
  </div>
</section>
<style>
  .stm { overflow: hidden; text-align: center; }
  .stm__orn { position: absolute; left: 50%; top: 0; width: 140%; height: 100%; transform: translateX(-50%); color: var(--copper); opacity: .07; pointer-events: none; }
  .stm__in { position: relative; display: grid; justify-items: center; gap: clamp(22px, 2.6vw, 40px); }
  .stm__title { color: #f4ede6; }
  .stm__text { max-width: 46ch; }
  .stm__frames { display: grid; grid-template-columns: 1fr 1.15fr; gap: var(--gutter); width: min(100%, 1180px); margin-top: clamp(30px, 5vw, 80px); align-items: end; text-align: left; }
  .stm__frame { position: relative; }
  .stm__frame--a { aspect-ratio: 4 / 5; margin-bottom: 12%; }
  .stm__frame--b { aspect-ratio: 4 / 5; }
  .stm__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .stm__cap { position: absolute; left: 14px; bottom: 14px; color: #fff; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
  @media (max-width: 860px) { .stm__frames { grid-template-columns: 1fr; } .stm__frame--a { margin: 0; } }
</style>
