---
// "From colonies to skylines" scroll scene (home, right after the navy statement). Real photo cut-outs of Indian
// construction layered over the live sky (Sky.astro shows through: this section has no background), from far to
// near: Kochi apartment towers, Mumbai towers under construction with cranes, a row of modern Indian homes and two
// palms framing the edges. Scroll stages the entrance: the palms spring up with a bounce and sway in the wind, then
// the homes rise one by one, then the buildings rise behind them; a slow camera push finishes it. All licensed stock (credited on /credits via vision-media.json → vision.parallax-*), shown as a
// concept visualisation, never as Defence Garden projects. Cut-outs: Apple Vision subject lifting.
// Script: src/scripts/modules/skylineRise.js. Reduced motion: the finished scene, static.
// data-depth on a layer = weight of the pointer parallax; the choreography itself lives in the script.
import { Image } from 'astro:assets';
import towersFar from '../../assets/vision/parallax/in-towers-far.webp';
import construction from '../../assets/vision/parallax/in-construction.webp';
import homeVilla from '../../assets/vision/parallax/in-home-villa.webp';
import homeModern from '../../assets/vision/parallax/in-home-modern.webp';
import homeContemporary from '../../assets/vision/parallax/in-home-contemporary.webp';
import palmRoyal from '../../assets/vision/parallax/in-palm-royal.webp';
import palmDate from '../../assets/vision/parallax/in-palm-date.webp';

const layers = [
  { cls: 'far', src: towersFar, w: [800, 1200, 1800, 2400], sizes: '(min-width: 861px) 46vw, 120vw', depth: 0.15 },
  { cls: 'build', src: construction, w: [640, 960, 1280, 1800], sizes: '(min-width: 861px) 46vw, 100vw', depth: 0.35 },
  { cls: 'mist' },
  { cls: 'villa', src: homeVilla, w: [480, 800, 1200, 1600], sizes: '(min-width: 861px) 40vw, 90vw', depth: 0.7 },
  { cls: 'modern', src: homeModern, w: [480, 800, 1200, 1500], sizes: '(min-width: 861px) 36vw, 80vw', depth: 0.8 },
  { cls: 'contemporary', src: homeContemporary, w: [480, 800, 1200, 1400], sizes: '(min-width: 861px) 30vw, 78vw', depth: 0.9 },
  { cls: 'ground' },
  { cls: 'palm-l', src: palmRoyal, w: [400, 700, 1000, 1200], sizes: '(min-width: 861px) 26vw, 52vw', depth: 1.3 },
  { cls: 'palm-r', src: palmDate, w: [400, 700, 1000, 1200], sizes: '(min-width: 861px) 28vw, 56vw', depth: 1.4 },
];
---
<section class="rise" data-skyline data-header-tone="light">
  <div class="rise__dawn" data-header-tone="dark" aria-hidden="true"></div>
  <div class="rise__stage" role="img" aria-label="Concept visualisation: modern Indian homes in front, residential towers under construction rising behind them into the sky">
    {layers.map((l) => l.src ? (
      <div class={`rise__l rise__${l.cls}`} data-layer data-depth={l.depth}>
        <div class="rise__in"><Image src={l.src} widths={l.w} sizes={l.sizes} alt="" loading="lazy" decoding="async" /></div>
      </div>
    ) : (
      <div class={`rise__${l.cls}`} aria-hidden="true"></div>
    ))}
    <div class="rise__beats">
      <div class="rise__beat" data-skyline-beat data-at="0.14">
        <p class="eyebrow eyebrow--accent">Where we began</p>
        <p class="deco rise__line">From plotted colonies</p>
      </div>
      <div class="rise__beat" data-skyline-beat data-at="0.56">
        <p class="eyebrow eyebrow--accent">Where we are going</p>
        <p class="deco rise__line">To the skylines of urban India</p>
      </div>
    </div>
    <span class="rise__tag">Concept visualisation</span>
  </div>
</section>

<style>
  .rise { position: relative; height: 320vh; }
  /* navy dawn continuing the statement above, opening onto the sky */
  .rise__dawn { position: absolute; top: 0; left: 0; right: 0; height: 50vh; pointer-events: none; background: linear-gradient(180deg, var(--navy-deep) 0%, rgba(6, 26, 58, .55) 42%, rgba(6, 26, 58, 0) 100%); }
  .rise__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .rise__l { position: absolute; will-change: transform; transform-origin: 50% 100%; }
  .rise__in { will-change: transform; }
  .rise__l :global(img) { display: block; width: 100%; height: auto; }
  /* the haze, colour and faded bases are baked into the images (para/tool/bake.mjs), so layers are plain bitmaps */
  .rise__far { left: 17%; width: 46vw; bottom: 37%; }
  .rise__build { left: 50%; width: 46vw; bottom: 25%; }
  .rise__mist { position: absolute; left: 0; right: 0; bottom: 14%; height: 34%; pointer-events: none; background: radial-gradient(130% 100% at 50% 100%, rgba(244, 247, 251, .95) 0%, rgba(244, 247, 251, .6) 42%, rgba(244, 247, 251, 0) 74%); }
  /* homes: their bases fade into the ground, which meets the translucent ivory of the next section */
  .rise__villa { left: -3%; width: 40vw; bottom: 4%; }
  .rise__modern { left: 63%; width: 36vw; bottom: -1%; }
  .rise__contemporary { left: 33%; width: 30vw; bottom: -5%; }
  .rise__ground { position: absolute; left: 0; right: 0; bottom: 0; height: 13%; pointer-events: none; background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--ivory) 82%, transparent) 70%); }
  /* foreground palms framing the edges (fastest layer) */
  .rise__palm-l { left: -9%; width: 26vw; bottom: -8%; }
  .rise__palm-r { left: 79%; width: 28vw; bottom: -12%; }
  .rise__beats { position: absolute; left: var(--gutter); top: 14%; display: grid; }
  .rise__beat { grid-area: 1 / 1; display: grid; gap: 10px; max-width: 24ch; }
  .rise__beat { opacity: 0; visibility: hidden; }
  .rise__beat .eyebrow { color: #8a4a36; text-shadow: 0 0 10px rgba(255, 255, 255, 1), 0 0 3px rgba(255, 255, 255, .95); }
  .rise__line { color: var(--navy); font-size: clamp(28px, 2.9vw, 50px); line-height: 1.02; text-shadow: 0 0 22px rgba(255, 255, 255, .85), 0 0 6px rgba(255, 255, 255, .7); }
  .rise__tag { position: absolute; right: var(--gutter); top: calc(var(--header-h) + 14px); padding: 4px 9px; border: 1px solid currentColor; color: var(--navy); font-size: 9px; letter-spacing: .16em; text-transform: uppercase; background: rgba(251, 248, 243, .7); }
  @media (max-width: 860px) {
    .rise { height: 280vh; }
    .rise__far { left: -10%; width: 120vw; bottom: 44%; }
    .rise__build { left: 14%; width: 100vw; bottom: 30%; }
    .rise__mist { bottom: 16%; height: 30%; }
    .rise__villa { left: -42%; width: 92vw; bottom: 8%; }
    .rise__modern { left: 46%; width: 82vw; bottom: 3%; }
    .rise__contemporary { left: 8%; width: 78vw; bottom: -2%; }
    .rise__palm-l { left: -24%; width: 54vw; bottom: -6%; }
    .rise__palm-r { left: 72%; width: 58vw; bottom: -10%; }
    .rise__beats { top: 13%; }
    .rise__line { font-size: clamp(26px, 8vw, 40px); }
    .rise__tag { top: auto; bottom: 18px; right: auto; left: var(--gutter); }
  }
  /* reduced motion: the finished scene (CSS positions are the end state), both beats, no long scroll */
  @media (prefers-reduced-motion: reduce) {
    .rise { height: auto; }
    .rise__stage { position: relative; }
    .rise__beats { gap: 22px; }
    .rise__beat { grid-area: auto; }
    .rise__beat { opacity: 1; visibility: visible; }
  }
</style>
