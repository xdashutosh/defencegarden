---
// era.estate navy band: thin capitals title + draggable strip of concept photographs (licensed, realistic).
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
const slides = [
  { vision: 'skyline-dusk', fb: 'about.r3', cap: 'Urban skylines' },
  { vision: 'towers-modern', fb: 'projects.defence-garden-phase-2.gallery-06', cap: 'Residential towers' },
  { vision: 'balcony-view', fb: 'projects.river-green-society.gallery-02', cap: 'Homes with a view' },
  { vision: 'interior-glass', fb: 'projects.defence-garden-meerut.gallery-06', cap: 'Light-filled interiors' },
  { vision: 'family-balcony', fb: 'projects.river-green-society.gallery-11', cap: 'Evenings above the city' },
  { vision: 'rooftop-garden', fb: 'projects.defence-garden-phase-1.gallery-08', cap: 'Gardens in the sky' },
  { vision: 'facade-glass', fb: 'projects.river-green-society.gallery-11', cap: 'Craft & materials' },
  { vision: 'architect-model', fb: 'about.r4', cap: 'Planned to the last detail' },
];
---
<section class="vbd t-night section" data-header-tone="dark" data-strip>
  <div class="wrap vbd__head">
    <div class="sec-head">
      <p class="eyebrow eyebrow--accent" data-reveal="fade">The vision</p>
      <h2 class="deco" data-reveal="lines">Rising<br />higher</h2>
    </div>
    <div class="vbd__copy">
      <p class="lead balance" data-reveal="fade">Planned societies, gated security and clear titles made our colonies trusted addresses. The next Defence Garden homes will stack those same promises into residential high-rise communities in urban India.</p>
      <div class="vbd__nav">
        <a class="btn btn--copper" href="/vision"><span>Explore the vision</span><Icon name="arrow-right" /></a>
        <div class="strip__nav">
          <span class="eyebrow muted" data-strip-count>01 / 08</span>
          <button class="round-btn" type="button" data-strip-prev aria-label="Previous"><Icon name="arrow-left" /></button>
          <button class="round-btn" type="button" data-strip-next aria-label="Next"><Icon name="arrow-right" /></button>
        </div>
      </div>
    </div>
  </div>
  <ul class="strip__track vbd__track" data-strip-track>
    {slides.map((s, i) => (
      <li class={`vbd__slide ${i % 3 === 1 ? 'is-tall' : ''}`}>
        <div class="frame vbd__frame"><span class="frame__line" data-drift="28" aria-hidden="true"></span><figure class="media vbd__img"><Img vision={s.vision} src={s.fb} sizes="(min-width: 861px) 34vw, 80vw" widths={[480, 800, 1200, 1600]} /><span class="concept-tag">Concept</span></figure></div>
        <figcaption class="eyebrow vbd__cap"><span class="accent">{String(i + 1).padStart(2, '0')}</span> {s.cap}</figcaption>
      </li>
    ))}
  </ul>
</section>
<style>
  .vbd { overflow: hidden; }
  .vbd__head { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); align-items: end; margin-bottom: clamp(40px, 5vw, 80px); }
  .vbd__head .deco { color: #f4ede6; }
  .vbd__copy { display: grid; gap: 28px; }
  .vbd__nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .vbd__track { padding-inline: var(--gutter); align-items: end; }
  .vbd__slide { width: clamp(260px, 32vw, 560px); display: grid; gap: 30px; }
  .vbd__frame { --fr-x: 14px; --fr-y: 14px; }
  .vbd__img { aspect-ratio: 4 / 3; }
  .vbd__slide.is-tall .vbd__img { aspect-ratio: 4 / 5; }
  .vbd__img :global(img) { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .vbd__cap { color: rgba(244,237,230,.8); }
  @media (max-width: 860px) { .vbd__head { grid-template-columns: 1fr; } .vbd__slide { width: 78vw; } }
</style>
