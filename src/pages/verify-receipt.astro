---
// /verify-receipt?token=… — QR target printed on every signed receipt (booking PDFs and the sales app's
// farmer / vendor / commission / expense / day-book / imprest / NOC / plot receipts). NEVER change this path
// or the `token` query parameter. Logic: src/scripts/booking/verify.js (mounted on [data-verify-receipt]).
// Private utility: noindex, nofollow, referrer no-referrer.
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Ornament from '../components/ui/Ornament.astro';
import { getProject } from '../lib/site.js';

const api = (import.meta.env.PUBLIC_DG_API_BASE || getProject(1)?.bookingMap?.api || 'https://rivergreenbackend.onrender.com/api').replace(/\/+$/, '');
const ring = '★ DIGITALLY VERIFIED · DEFENCE GARDEN · AUTHENTIC RECEIPT · ';
---
<Base path="/verify-receipt" namespace="utility" tone="light" noindex title="Defence Garden Payment Verification System">
  <section class="vr t-ivory" data-header-tone="light" data-verify-receipt data-api={api}>
    <Ornament variant="fan" class="vr__fan" />
    <div class="wrap vr__wrap">
      <header class="vr__head">
        <p class="eyebrow eyebrow--accent">Official Verification Portal</p>
        <h1 class="serif vr__title balance">Defence Garden Payment Verification System</h1>
        <p class="body muted vr__intro balance">Every receipt carries a cryptographic signature. This page confirms it was issued by Defence Garden and has not been tampered with.</p>
      </header>

      <div class="vr__card">
        <!-- loading -->
        <div class="vr-state" data-view="loading">
          <div class="vr-stamp vr-stamp--loading" aria-hidden="true">
            <svg viewBox="0 0 200 200"><circle class="vr-stamp__ring" cx="100" cy="100" r="92" /><circle class="vr-stamp__dash" cx="100" cy="100" r="74" /></svg>
          </div>
          <p class="vr-state__title" role="status">Verifying cryptographic signature…</p>
          <p class="small muted">This only takes a second.</p>
          <p class="small muted" data-vr-slow hidden>Waking up the verification service…</p>
        </div>

        <!-- valid -->
        <div class="vr-valid" data-view="valid" hidden>
          <div class="vr-valid__top">
            <div class="vr-valid__heading">
              <p class="eyebrow eyebrow--accent">Certificate of Authenticity</p>
              <h2 class="vr-valid__type" data-vr-type></h2>
              <p class="vr-chip"><span class="eyebrow">Receipt No.</span> <code data-vr-no></code></p>
            </div>
            <div class="vr-stamp vr-stamp--ok" aria-hidden="true">
              <svg viewBox="0 0 200 200">
                <defs><path id="vr-ring-path" d="M100 100 m-80 0 a80 80 0 1 1 160 0 a80 80 0 1 1 -160 0" /></defs>
                <circle class="vr-stamp__ring" cx="100" cy="100" r="96" />
                <circle class="vr-stamp__ring vr-stamp__ring--in" cx="100" cy="100" r="64" />
                <g class="vr-stamp__spin"><text class="vr-stamp__text"><textPath href="#vr-ring-path" textLength="498">{ring}</textPath></text></g>
                <text class="vr-stamp__word" x="100" y="106" text-anchor="middle">VERIFIED</text>
              </svg>
            </div>
          </div>

          <div class="vr-amount">
            <p class="eyebrow muted" data-vr-amount-label>Amount</p>
            <p class="vr-amount__value"><span class="vr-amount__cur">₹</span><span data-vr-amount></span></p>
            <p class="small muted">Indian Rupees</p>
          </div>

          <div class="vr-site">
            <span class="vr-site__ico" aria-hidden="true"><Icon name="pin" class="ico" /></span>
            <div>
              <p class="eyebrow muted">Site / Project</p>
              <p class="vr-site__name" data-vr-site></p>
              <p class="small muted" data-vr-address hidden></p>
            </div>
          </div>

          <dl class="vr-tiles">
            <div><dt class="eyebrow" data-vr-party-label>Party</dt><dd data-vr-party></dd></div>
            <div><dt class="eyebrow">Transaction Date</dt><dd data-vr-date></dd></div>
            <div><dt class="eyebrow">Payment Mode</dt><dd data-vr-mode></dd></div>
            <div><dt class="eyebrow">Receipt ID</dt><dd><code data-vr-id></code></dd></div>
          </dl>

          <div class="vr-meta">
            <span class="vr-meta__ok" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 12.5 4 4 8-9" /></svg></span>
            <p><strong>Verification succeeded</strong><br /><span class="small muted" data-vr-verified-on></span></p>
          </div>
        </div>

        <!-- invalid / unreachable -->
        <div class="vr-state vr-state--bad" data-view="invalid" data-load-error hidden>
          <div class="vr-stamp vr-stamp--bad" aria-hidden="true">
            <svg viewBox="0 0 200 200">
              <circle class="vr-stamp__ring" cx="100" cy="100" r="92" />
              <circle class="vr-stamp__dash" cx="100" cy="100" r="80" />
              <text class="vr-stamp__word" x="100" y="107" text-anchor="middle">INVALID</text>
            </svg>
          </div>
          <h2 class="vr-state__title">Receipt Could Not Be Verified</h2>
          <p class="body" data-vr-msg role="alert">Unable to reach the verification service. Please try again.</p>
          <p class="small muted">If you believe this is an error, please contact the issuing office.</p>
          <button type="button" class="btn btn--solid" data-vr-retry hidden><span>Try again</span></button>
        </div>
        <noscript><p class="body vr-noscript">Please enable JavaScript to verify this receipt.</p></noscript>
      </div>

      <footer class="vr__foot">
        <a class="btn" href="/"><span>Go to Home</span><Icon name="arrow-right" class="ico" /></a>
        <p class="eyebrow muted">HMAC-SHA256 signed · tamper-evident</p>
      </footer>
    </div>
  </section>
</Base>

<style>
  .vr :global([hidden]) { display: none !important; }
  .vr { position: relative; overflow: clip; isolation: isolate; padding-top: calc(var(--header-h) + clamp(40px, 6vw, 96px)); padding-bottom: clamp(72px, 9vw, 150px); min-height: 92svh; }
  .vr__fan { position: absolute; z-index: -1; left: 50%; top: -10%; width: min(1400px, 140vw); transform: translateX(-50%); color: var(--copper); opacity: .1; pointer-events: none; }
  .vr__wrap { max-width: 980px; }
  .vr__head { display: grid; gap: 16px; justify-items: center; text-align: center; margin-bottom: clamp(32px, 4vw, 56px); }
  .vr__title { font-size: clamp(36px, 4.6vw, 76px); max-width: 16ch; }
  .vr__intro { max-width: 56ch; }
  .vr__card { position: relative; background: var(--paper); border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); padding: clamp(24px, 4.4vw, 64px); min-height: 300px; }
  .vr__card::before { content: ''; position: absolute; inset: 10px; border: 1px solid color-mix(in srgb, var(--copper) 35%, transparent); pointer-events: none; }
  .vr-noscript { text-align: center; }
  .vr__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 24px; }

  .vr-state { display: grid; justify-items: center; text-align: center; gap: 12px; padding-block: 8px; }
  .vr-state[hidden], .vr-valid[hidden] { display: none; }
  .vr-state__title { font-family: var(--f-serif); font-weight: 300; font-size: clamp(26px, 2.6vw, 40px); letter-spacing: -.02em; margin-top: 8px; }
  .vr-state--bad [data-vr-msg] { max-width: 48ch; }
  .vr-state--bad .btn { margin-top: 8px; }

  .vr-stamp { width: clamp(132px, 13vw, 176px); aspect-ratio: 1; flex: none; }
  .vr-stamp svg { width: 100%; height: 100%; overflow: visible; }
  .vr-stamp__ring { fill: none; stroke: currentColor; stroke-width: 1.2; }
  .vr-stamp__ring--in { stroke-width: .8; }
  .vr-stamp__dash { fill: none; stroke: currentColor; stroke-width: 1; stroke-dasharray: 4 6; }
  .vr-stamp__text { font-family: var(--f-wide); font-stretch: 125%; font-size: 11.4px; letter-spacing: .06em; fill: currentColor; }
  .vr-stamp__word { font-family: var(--f-deco); font-weight: 400; font-size: 21px; letter-spacing: .14em; fill: currentColor; }
  .vr-stamp__spin { transform-origin: 100px 100px; animation: vr-spin 18s linear infinite; }
  .vr-stamp--ok { color: var(--green); }
  .vr-stamp--bad { color: #b3261e; transform: rotate(-8deg); }
  .vr-stamp--loading { color: var(--copper-deep); }
  .vr-stamp--loading svg { animation: vr-spin 3s linear infinite; }
  @keyframes vr-spin { to { transform: rotate(360deg); } }

  .vr-valid { display: grid; gap: clamp(24px, 3vw, 40px); }
  .vr-valid__top { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .vr-valid__heading { display: grid; gap: 12px; justify-items: start; }
  .vr-valid__type { font-family: var(--f-sans); font-weight: 500; font-size: clamp(30px, 3.4vw, 54px); line-height: 1; letter-spacing: -.035em; }
  .vr-chip { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent); border-radius: 999px; }
  .vr-chip code, .vr-tiles code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }

  .vr-amount { display: grid; gap: 6px; padding-block: clamp(20px, 2.4vw, 32px); border-block: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
  .vr-amount__value { display: flex; align-items: baseline; gap: .12em; font-family: var(--f-sans); font-weight: 500; font-size: clamp(52px, 7vw, 112px); line-height: .95; letter-spacing: -.045em; color: var(--navy-deep); }
  .vr-amount__cur { font-family: var(--f-serif); font-weight: 300; font-size: .55em; color: var(--copper-deep); }

  .vr-site { display: flex; gap: 16px; align-items: flex-start; }
  .vr-site__ico { width: 44px; height: 44px; flex: none; display: grid; place-items: center; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--copper) 60%, transparent); color: var(--copper-deep); }
  .vr-site__ico :global(svg) { width: 20px; height: 20px; }
  .vr-site__name { font-size: 20px; font-weight: 500; margin: 4px 0 2px; }

  .vr-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
  .vr-tiles > div { padding: 18px 16px 4px 0; display: grid; gap: 8px; align-content: start; }
  .vr-tiles > div + div { padding-left: 16px; border-left: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
  .vr-tiles dt { color: color-mix(in srgb, var(--fg) 60%, transparent); }
  .vr-tiles dd { margin: 0; font-size: 16px; overflow-wrap: anywhere; }

  .vr-meta { display: flex; align-items: center; gap: 14px; padding: 16px 18px; background: color-mix(in srgb, var(--green) 8%, transparent); border: 1px solid color-mix(in srgb, var(--green) 30%, transparent); }
  .vr-meta__ok { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--green); color: #fff; }
  .vr-meta__ok svg { width: 18px; height: 18px; }
  .vr-meta strong { font-weight: 500; }

  @media (max-width: 860px) {
    .vr-valid__top { flex-direction: column-reverse; align-items: flex-start; }
    .vr-tiles { grid-template-columns: 1fr 1fr; }
    .vr-tiles > div:nth-child(3) { padding-left: 0; border-left: 0; }
    .vr-tiles > div:nth-child(n + 3) { border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
    .vr__card { padding: 28px 20px; }
    .vr__card::before { inset: 6px; }
    .vr__foot { justify-content: center; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vr-stamp__spin, .vr-stamp--loading svg { animation: none !important; }
  }
</style>
