---
// /credits — image credits & licences: every licensed concept item (src/lib/vision.js visionCredits()), the
// statement that every other photograph and film is Defence Garden's own, and the font licences (SIL OFL 1.1).
// Styles are inline so they travel with the Barba container.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Ornament from '../components/ui/Ornament.astro';
import { visionCredits, vision, visionVideo } from '../lib/vision.js';
import { email } from '../lib/site.js';

const pad = (n) => String(n).padStart(2, '0');
const credits = visionCredits().map((c, i) => {
  const thumb = c.kind === 'video' ? visionVideo(c.key)?.poster ?? null : vision(c.key)?.image ?? null;
  return { ...c, n: pad(i + 1), thumb };
});
const images = credits.filter((c) => c.kind !== 'video').length;
const films = credits.length - images;
const sources = [...new Set(credits.map((c) => c.source).filter(Boolean))];

const OFL = 'https://openfontlicense.org';
const fonts = [
  {
    name: 'Google Sans', role: 'Headlines, navigation and body text', css: 'var(--f-sans)', sample: 'From colonies to skylines',
    copyright: 'Copyright 2017 Google, Inc. All Rights Reserved.',
    via: { label: '@fontsource-variable/google-sans', href: 'https://fontsource.org/fonts/google-sans' },
    file: { label: 'Licence file (OFL-GoogleSans.txt)', href: '/fonts/OFL-GoogleSans.txt' },
  },
  {
    name: 'Fraunces', role: 'Serif headlines and quotations', css: 'var(--f-serif)', sample: 'Every plot is a promise',
    copyright: 'Copyright 2020 The Fraunces Project Authors (github.com/undercasetype/Fraunces)',
    via: { label: '@fontsource-variable/fraunces', href: 'https://fontsource.org/fonts/fraunces' },
    file: { label: 'Licence file (OFL-Fraunces.txt)', href: '/fonts/OFL-Fraunces.txt' },
  },
  {
    name: 'Jost', role: 'Thin geometric capitals', css: 'var(--f-deco)', sample: 'RISING HIGHER', deco: true,
    copyright: 'Copyright 2020 The Jost Project Authors (https://github.com/indestructible-type/Jost)',
    via: { label: '@fontsource-variable/jost', href: 'https://fontsource.org/fonts/jost' },
    file: { label: 'Licence file (OFL-Jost.txt)', href: '/fonts/OFL-Jost.txt' },
  },
  {
    name: 'Mona Sans', role: 'Wide labels and eyebrows', css: 'var(--f-wide)', sample: 'DEFENCE GARDEN · EST. 2006', wide: true,
    copyright: 'Copyright 2022 The Mona Sans Project Authors (https://github.com/github/mona-sans), with Reserved Font Name "Mona"',
    via: { label: 'github.com/github/mona-sans', href: 'https://github.com/github/mona-sans' },
    file: { label: 'Licence file (OFL-MonaSans.txt)', href: '/fonts/OFL-MonaSans.txt' },
  },
];
---
<Base
  path="/credits"
  namespace="credits"
  tone="light"
  title="Image Credits & Licences | Defence Garden"
  description="Credits and licences for the concept images, films and typefaces used on the Defence Garden website. All other photographs and films are Defence Garden's own."
>
  <style is:inline>
    .crd-hero { position: relative; overflow: hidden; padding: calc(var(--header-h) + clamp(50px, 8vw, 130px)) 0 clamp(50px, 6vw, 100px); }
    .crd-hero__in { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(30px, 5vw, 100px); align-items: end; }
    .crd-hero__title { font-size: clamp(48px, 7.6vw, 140px); }
    .crd-hero__aside { display: grid; gap: 20px; }
    .crd-hero__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid color-mix(in srgb, var(--fg) 16%, transparent); }
    .crd-hero__stats li { display: grid; gap: 6px; padding: 18px 12px 0 0; }
    .crd-hero__stats li + li { padding-left: 14px; border-left: 1px solid color-mix(in srgb, var(--fg) 16%, transparent); }
    .crd-hero__stats b { font-family: var(--f-sans); font-weight: 500; font-size: clamp(34px, 3.4vw, 60px); letter-spacing: -.045em; line-height: .95; }

    .crd-own { position: relative; overflow: hidden; }
    .crd-own__orn { position: absolute; left: 50%; top: 0; width: 130%; height: 100%; transform: translateX(-50%); color: var(--copper); opacity: .07; pointer-events: none; }
    .crd-own__grid { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(30px, 5vw, 90px); }
    .crd-own__item { display: grid; gap: 18px; align-content: start; padding-top: 24px; border-top: 1px solid rgba(244, 237, 230, .2); }
    .crd-own__item h2 { font-family: var(--f-deco); font-weight: 300; text-transform: uppercase; font-size: clamp(28px, 2.8vw, 48px); line-height: 1.02; color: #f4ede6; }
    .crd-own__tag { justify-self: start; padding: 6px 10px; border: 1px solid currentColor; }
    .crd-own__tag--dg { color: var(--copper); }

    .crd-list__head { display: flex; justify-content: space-between; align-items: end; gap: var(--gutter); flex-wrap: wrap; margin-bottom: clamp(30px, 4vw, 60px); }
    .crd-list__rows { border-top: 1px solid color-mix(in srgb, var(--fg) 16%, transparent); }
    .crd-row { display: grid; grid-template-columns: 44px 132px minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr); gap: clamp(14px, 2vw, 30px); align-items: center; padding: 18px 0; border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
    .crd-row__n { font-family: var(--f-wide); font-stretch: 125%; font-size: 10px; letter-spacing: .12em; color: var(--accent); }
    .crd-row__thumb { position: relative; aspect-ratio: 4 / 3; border-radius: 2px; }
    .crd-row__thumb img { width: 100%; height: 100%; object-fit: cover; }
    .crd-row__thumb .concept-tag { right: 6px; bottom: 5px; font-size: 7px; }
    .crd-row__kind { position: absolute; left: 6px; top: 5px; z-index: 2; display: inline-flex; align-items: center; gap: 4px; color: #fff; font-size: 9px; text-shadow: 0 1px 4px rgba(0, 0, 0, .6); }
    .crd-row__kind .ico { width: 10px; height: 10px; fill: currentColor; }
    .crd-row__desc { font-size: 15px; line-height: 1.45; }
    .crd-row__key { margin-top: 6px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; }
    .crd-row__k { display: block; margin-bottom: 4px; }
    .crd-row a { color: var(--fg); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 70%, transparent); text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .crd-row a:hover { color: var(--accent); }
    .crd-row__attr { display: block; margin-top: 6px; font-size: 12px; }
    .crd-empty { display: grid; gap: 10px; padding: 30px 0; border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }

    .crd-fonts__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(10px, 1.2vw, 20px); }
    .crd-font { display: grid; gap: 18px; align-content: start; padding: clamp(22px, 2.6vw, 40px); border: 1px solid color-mix(in srgb, var(--fg) 16%, transparent); border-radius: 4px; background: var(--paper); }
    .crd-font__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .crd-font__name { font-size: clamp(24px, 2.2vw, 36px); font-weight: 500; letter-spacing: -.03em; line-height: 1; }
    .crd-font__sample { font-size: clamp(30px, 3.4vw, 58px); line-height: 1.02; letter-spacing: -.03em; padding-block: 6px 14px; border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); overflow-wrap: anywhere; }
    .crd-font__sample.is-deco { font-weight: 300; letter-spacing: 0; }
    .crd-font__sample.is-wide { font-stretch: 125%; font-weight: 500; font-size: clamp(18px, 1.8vw, 28px); letter-spacing: .1em; }
    .crd-font__meta { display: grid; gap: 10px; font-size: 14px; line-height: 1.5; }
    .crd-font__links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; }
    .crd-font__links a { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); }
    .crd-font__links .ico { width: 14px; height: 14px; }
    .crd-note { margin-top: clamp(26px, 3vw, 44px); max-width: 80ch; }
    .crd-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 1100px) {
      .crd-row { grid-template-columns: 34px 112px minmax(0, 1fr); align-items: start; }
      .crd-row__src, .crd-row__lic { grid-column: 3; }
    }
    @media (max-width: 860px) {
      .crd-hero__in, .crd-own__grid, .crd-fonts__grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 520px) {
      .crd-row { grid-template-columns: 96px minmax(0, 1fr); gap: 6px 14px; }
      .crd-row__n { display: none; }
      .crd-row__thumb { grid-row: span 3; }
      .crd-row__src, .crd-row__lic { grid-column: 2; }
    }
  </style>

  <section class="crd-hero t-light" data-header-tone="light">
    <div class="wrap crd-hero__in">
      <div class="sec-head">
        <p class="eyebrow eyebrow--accent" data-reveal="fade" data-reveal-intro>Credits</p>
        <h1 class="display crd-hero__title" data-reveal="lines" data-reveal-intro data-reveal-delay="0.1">Image credits &amp; licences</h1>
      </div>
      <div class="crd-hero__aside" data-reveal="fade" data-reveal-intro data-reveal-delay="0.3">
        <p class="lead balance">The licensed concept images and films used on this website, who made them and how they are licensed — plus the typefaces we use.</p>
        <ul class="crd-hero__stats">
          <li><b>{pad(images)}</b><span class="eyebrow muted">Concept images</span></li>
          <li><b>{pad(films)}</b><span class="eyebrow muted">Concept films</span></li>
          <li><b>{pad(fonts.length)}</b><span class="eyebrow muted">Typefaces</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="crd-own t-night section--tight" data-header-tone="dark">
    <Ornament variant="fan" class="crd-own__orn" />
    <div class="wrap crd-own__grid">
      <div class="crd-own__item" data-reveal="fade">
        <p class="eyebrow crd-own__tag crd-own__tag--dg">Defence Garden</p>
        <h2>Our own photographs &amp; films</h2>
        <p class="body muted">All other photographs and films on this website — our colonies, homes, roads, gates, parks and drone footage — are Defence Garden’s own.</p>
      </div>
      <div class="crd-own__item" data-reveal="fade" data-reveal-delay="0.1">
        <p class="eyebrow crd-own__tag">Concept</p>
        <h2>Concept visualisations</h2>
        <p class="body muted">Images marked “concept” are representative visualisations from licensed stock libraries and do not depict Defence Garden projects. Future high-rise projects will be announced with their approvals.</p>
      </div>
    </div>
  </section>

  <section class="crd-list t-light section--tight" data-header-tone="light" aria-labelledby="crd-list-h">
    <div class="wrap">
      <div class="crd-list__head">
        <div class="sec-head">
          <p class="eyebrow eyebrow--accent" data-reveal="fade">Concept imagery{sources.length > 0 && ` · ${sources.join(' · ')}`}</p>
          <h2 class="serif serif--sm" id="crd-list-h" data-reveal="lines">Licensed concept images and films</h2>
        </div>
        <p class="eyebrow muted">{pad(credits.length)} items</p>
      </div>
      {credits.length === 0 ? (
        <div class="crd-empty">
          <p class="lead">No licensed concept images or films are in use on the website at the moment.</p>
          <p class="body muted">Every image currently shown is a Defence Garden photograph. When concept media is added, its source, author and licence will be listed here.</p>
        </div>
      ) : (
        <ol class="crd-list__rows">
          {credits.map((c) => (
            <li class="crd-row" data-reveal="fade">
              <span class="crd-row__n">{c.n}</span>
              <div class="crd-row__thumb media">
                {c.thumb && <Image src={c.thumb} alt="" widths={[160, 320]} sizes="132px" loading="lazy" decoding="async" data-concept />}
                <span class="crd-row__kind eyebrow">{c.kind === 'video' && <Icon name="play" />}{c.kind === 'video' ? 'Film' : 'Image'}</span>
                <span class="concept-tag">Concept</span>
              </div>
              <div>
                <p class="crd-row__desc">{c.alt}</p>
                <p class="crd-row__key muted">{c.key}</p>
              </div>
              <div class="crd-row__src small">
                <span class="eyebrow muted crd-row__k">Author · Source</span>
                {c.author ? (c.authorUrl ? <a href={c.authorUrl} target="_blank" rel="noopener">{c.author}</a> : <span>{c.author}</span>) : <span class="muted">—</span>}
                {c.source && <> · {c.sourceUrl ? <a href={c.sourceUrl} target="_blank" rel="noopener">{c.source}</a> : <span>{c.source}</span>}</>}
              </div>
              <div class="crd-row__lic small">
                <span class="eyebrow muted crd-row__k">Licence</span>
                {c.license ? (c.licenseUrl ? <a href={c.licenseUrl} target="_blank" rel="noopener">{c.license}</a> : <span>{c.license}</span>) : <span class="muted">—</span>}
                {c.attribution && <span class="crd-row__attr muted">{c.attribution}</span>}
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section class="crd-fonts t-ivory section--tight" data-header-tone="light" aria-labelledby="crd-fonts-h">
    <div class="wrap">
      <div class="crd-list__head">
        <div class="sec-head">
          <p class="eyebrow eyebrow--accent" data-reveal="fade">Typefaces · SIL Open Font License 1.1</p>
          <h2 class="serif serif--sm" id="crd-fonts-h" data-reveal="lines">Font licences</h2>
        </div>
        <a class="btn" href={OFL} target="_blank" rel="noopener"><span>Read the OFL 1.1</span><Icon name="arrow-up-right" /></a>
      </div>
      <div class="crd-fonts__grid">
        {fonts.map((f, i) => (
          <article class="crd-font" data-reveal="fade" data-reveal-delay={(i * 0.06).toFixed(2)}>
            <div class="crd-font__top">
              <h3 class="crd-font__name">{f.name}</h3>
              <p class="eyebrow muted">{f.role}</p>
            </div>
            <p class={`crd-font__sample ${f.deco ? 'is-deco' : ''} ${f.wide ? 'is-wide' : ''}`} style={`font-family:${f.css}`} aria-hidden="true">{f.sample}</p>
            <div class="crd-font__meta">
              <p>{f.copyright}</p>
              <p class="muted">Licensed under the SIL Open Font License, Version 1.1.</p>
            </div>
            <div class="crd-font__links">
              <a href={OFL} target="_blank" rel="noopener">SIL OFL 1.1 <Icon name="arrow-up-right" /></a>
              <a href={f.via.href} target="_blank" rel="noopener">{f.via.label} <Icon name="arrow-up-right" /></a>
              {f.file && <a href={f.file.href} data-no-barba>{f.file.label} <Icon name="download" /></a>}
            </div>
          </article>
        ))}
      </div>
      <p class="crd-note small muted">Questions about an image or a licence? Write to us at <a href={email.href}>{email.address}</a>.</p>
    </div>
  </section>
</Base>
