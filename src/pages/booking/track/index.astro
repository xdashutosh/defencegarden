---
// /booking/track/<id> — ONE static page for every booking id (public/.htaccess rule 4 rewrites
// /booking/track/<id> here; the dev server does the same). The id is read from location.pathname by
// src/scripts/booking/track.js (mounted on [data-booking-track] via src/scripts/modules/plotmap.js).
// Private utility: noindex, nofollow, referrer no-referrer (src/lib/seo.js adds it for utility paths).
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/ui/Icon.astro';
import Ornament from '../../../components/ui/Ornament.astro';
import { getProject, whatsappNumber, phone, telHref, site } from '../../../lib/site.js';

const api = (import.meta.env.PUBLIC_DG_API_BASE || getProject(1)?.bookingMap?.api || 'https://rivergreenbackend.onrender.com/api').replace(/\/+$/, '');
const sales = phone('sales');
const signatory = 'RiverGreen Sales';
const steps = [
  { key: 'PENDING_APPROVAL', label: 'Submitted' },
  { key: 'ACTIVE', label: 'Verified' },
  { key: 'COMPLETED', label: 'Sold' },
];
const receiptNote = site?.legal?.bookingReceiptIdentity?.verificationNote || 'Signed PDF · QR-verifiable on defencegarden.com';
---
<Base path="/booking/track" namespace="utility" tone="light" noindex>
  <section class="trk t-ivory" data-header-tone="light" data-booking-track data-api={api}>
    <Ornament variant="fan" class="trk__fan" />
    <div class="wrap trk__wrap">
      <header class="trk__head">
        <p class="eyebrow eyebrow--accent">Private link · Booking tracker</p>
        <h1 class="serif trk__title">Track your booking</h1>
        <p class="body muted trk__intro">The live status of your plot booking with Defence Garden. Keep this link private.</p>
      </header>

      <div class="trk__card">
        <!-- loading -->
        <div class="trk-state" data-view="loading">
          <span class="trk-progress" aria-hidden="true"><i></i></span>
          <p class="eyebrow" role="status">Loading</p>
          <p class="small muted" data-trk-slow hidden>Waking up the booking service…</p>
        </div>

        <!-- service unreachable (network / CORS / timeout) -->
        <div class="trk-state" data-view="unreachable" data-load-error hidden>
          <span class="trk-state__ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 9.5a13 13 0 0 1 18 0M6.5 13a8 8 0 0 1 11 0M10 16.5a3 3 0 0 1 4 0"/><path d="M4 4l16 16"/></svg></span>
          <h2 class="trk-state__title">Service unavailable</h2>
          <p class="body muted" role="alert">We couldn’t reach the booking service. Please try again.</p>
          <div class="trk-state__actions">
            <button type="button" class="btn btn--solid" data-trk-retry><span>Try again</span></button>
            <a class="btn" href={telHref('sales')}><Icon name="phone" class="ico" /><span>{sales.display}</span></a>
          </div>
        </div>

        <!-- not found -->
        <div class="trk-state" data-view="notfound" hidden>
          <span class="trk-state__ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M9 9l6 6M15 9l-6 6"/></svg></span>
          <h2 class="trk-state__title" data-trk-nf-title>Booking Not Found</h2>
          <p class="body muted" data-trk-nf-msg role="alert">The booking link is invalid or has expired.</p>
          <div class="trk-state__actions">
            <a class="btn" href={telHref('sales')}><Icon name="phone" class="ico" /><span>Call {sales.display}</span></a>
          </div>
        </div>

        <!-- loaded -->
        <div class="trk-loaded" data-view="loaded" hidden>
          <div class="trk-top">
            <div>
              <p class="eyebrow eyebrow--accent" data-trk-colony></p>
              <h2 class="trk-plot" data-trk-plot></h2>
            </div>
            <div class="trk-status" data-trk-status data-tone="pending" role="status">
              <span class="trk-status__ico" aria-hidden="true">
                <svg data-tone-icon="pending" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5h10M7 20.5h10M8 3.5c0 4.5 8 4.5 8 8.5s-8 4-8 8.5M16 3.5c0 4.5-8 4.5-8 8.5s8 4 8 8.5"/></svg>
                <svg data-tone-icon="active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m8.4 12.3 2.5 2.5 4.9-5.2"/></svg>
                <svg data-tone-icon="done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 1.6 2.7-.2.9 2.6L20 8.6l-.9 2.6.9 2.6-2.2 1.6-.9 2.6-2.7-.2L12 21l-2.2-1.6-2.7.2-.9-2.6L4 15.4l.9-2.6L4 10.2l2.2-1.6.9-2.6 2.7.2Z"/><path d="m9 12 2.1 2.1L15.2 10"/></svg>
                <svg data-tone-icon="cancelled" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
                <svg data-tone-icon="transferred" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8.5h14l-3.5-3.5M20 15.5H6L9.5 19"/></svg>
              </span>
              <span>
                <strong class="trk-status__label" data-trk-status-label></strong>
                <span class="trk-status__msg small" data-trk-status-msg></span>
              </span>
            </div>
          </div>

          <ol class="trk-steps" data-trk-steps aria-label="Booking progress">
            {steps.map((s, i) => (
              <>
                <li class="trk-step" data-trk-step={s.key}>
                  <span class="trk-step__dot" aria-hidden="true">
                    <span class="trk-step__num">{i + 1}</span>
                    <svg class="trk-step__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 12.5 4 4 8-9" /></svg>
                  </span>
                  <span class="trk-step__label eyebrow">{s.label}</span>
                </li>
                {i < steps.length - 1 && <li class="trk-conn" data-trk-conn={i} aria-hidden="true"><i></i></li>}
              </>
            ))}
          </ol>

          <div class="trk-cols">
            <div>
              <h3 class="trk-h">Booking details</h3>
              <dl class="trk-details" data-trk-details></dl>
            </div>
            <div class="trk-side">
              <div class="trk-block">
                <h3 class="trk-h">Payment proof <span class="trk-badge" data-trk-proof-count>0</span></h3>
                <div class="trk-proof" data-trk-proof></div>
                <p class="small muted" data-trk-proof-empty>No payment screenshots on this booking yet.</p>
                <a class="trk-link link-line small" data-trk-wa data-wa={whatsappNumber} href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" class="ico" /> Send payment proof on WhatsApp</a>
              </div>
              <div class="trk-block">
                <h3 class="trk-h">Receipt</h3>
                <div class="trk-actions">
                  <button type="button" class="btn btn--solid" data-trk-receipt data-signatory={signatory}><Icon name="download" class="ico" /><span data-trk-receipt-label>Download Receipt (PDF)</span></button>
                  <button type="button" class="btn" data-trk-print><span>Print this page</span></button>
                </div>
                <p class="small muted">{receiptNote}</p>
                <p class="small trk-error" data-trk-receipt-error role="alert" hidden></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="trk__foot small muted">Booking ID: <code data-trk-id>—</code></p>
      <noscript><p class="body">Please enable JavaScript to see your booking status, or call {sales.display}.</p></noscript>
    </div>
  </section>
</Base>

<style>
  .trk :global([hidden]) { display: none !important; }
  .trk { position: relative; overflow: clip; isolation: isolate; padding-top: calc(var(--header-h) + clamp(40px, 6vw, 96px)); padding-bottom: clamp(72px, 9vw, 150px); min-height: 92svh; }
  .trk__fan { position: absolute; z-index: -1; left: 50%; top: -10%; width: min(1400px, 140vw); transform: translateX(-50%); color: var(--copper); opacity: .1; pointer-events: none; }
  .trk__wrap { max-width: 1120px; }
  .trk__head { display: grid; gap: 16px; justify-items: start; margin-bottom: clamp(32px, 4vw, 56px); }
  .trk__title { font-size: clamp(44px, 5.4vw, 92px); }
  .trk__intro { max-width: 52ch; }
  .trk__card { position: relative; background: var(--paper); border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); padding: clamp(24px, 4vw, 64px); min-height: 280px; }
  .trk__card::before { content: ''; position: absolute; inset: 10px; border: 1px solid color-mix(in srgb, var(--copper) 35%, transparent); pointer-events: none; }
  .trk__foot { margin-top: 18px; }
  .trk__foot code, .trk-row--mono dd { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; word-break: break-all; }

  .trk-state { display: grid; justify-items: center; text-align: center; gap: 14px; padding-block: clamp(24px, 4vw, 48px); }
  .trk-state[hidden], .trk-loaded[hidden] { display: none; }
  .trk-state__ico { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--copper) 60%, transparent); color: var(--copper-deep); }
  .trk-state__ico svg { width: 26px; height: 26px; }
  .trk-state__title { font-family: var(--f-serif); font-weight: 300; font-size: clamp(28px, 2.8vw, 42px); letter-spacing: -.02em; }
  .trk-state__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 8px; }
  .trk-progress { display: block; width: min(320px, 70%); height: 1px; background: color-mix(in srgb, var(--fg) 14%, transparent); overflow: hidden; }
  .trk-progress i { display: block; width: 40%; height: 100%; background: var(--copper-deep); animation: trk-load 1.4s var(--ease-in-out) infinite; }
  @keyframes trk-load { from { transform: translateX(-100%); } to { transform: translateX(250%); } }

  .trk-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: clamp(24px, 3vw, 40px); border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
  .trk-top > div:first-child { display: grid; gap: 10px; }
  .trk-plot { font-family: var(--f-sans); font-weight: 500; font-size: clamp(40px, 4.6vw, 76px); line-height: .95; letter-spacing: -.04em; }
  .trk-status { --tone: var(--copper-deep); display: flex; align-items: center; gap: 14px; padding: 14px 20px 14px 14px; border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent); background: color-mix(in srgb, var(--tone) 7%, transparent); max-width: 420px; }
  .trk-status[data-tone='active'] { --tone: var(--navy); }
  .trk-status[data-tone='done'] { --tone: var(--green); }
  .trk-status[data-tone='cancelled'] { --tone: #b3261e; }
  .trk-status[data-tone='transferred'] { --tone: var(--aubergine); }
  .trk-status__ico { width: 44px; height: 44px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--tone); color: #fff; }
  .trk-status__ico svg { width: 22px; height: 22px; display: none; }
  .trk-status[data-tone='pending'] [data-tone-icon='pending'],
  .trk-status[data-tone='active'] [data-tone-icon='active'],
  .trk-status[data-tone='done'] [data-tone-icon='done'],
  .trk-status[data-tone='cancelled'] [data-tone-icon='cancelled'],
  .trk-status[data-tone='transferred'] [data-tone-icon='transferred'] { display: block; }
  .trk-status__label { display: block; font-weight: 500; font-size: 17px; color: var(--tone); }
  .trk-status__msg { display: block; color: color-mix(in srgb, var(--fg) 72%, transparent); }

  .trk-steps { display: flex; align-items: flex-start; padding-block: clamp(28px, 3.4vw, 48px); border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
  .trk-step { display: grid; justify-items: center; gap: 12px; flex: none; width: 96px; text-align: center; }
  .trk-step__dot { position: relative; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--fg) 30%, transparent); color: color-mix(in srgb, var(--fg) 60%, transparent); font-weight: 500; background: var(--paper); transition: background .5s, color .5s, border-color .5s; }
  .trk-step__check { width: 20px; height: 20px; display: none; }
  .trk-step.is-done .trk-step__dot { background: var(--navy-deep); border-color: var(--navy-deep); color: #fff; }
  .trk-step.is-done .trk-step__num { display: none; }
  .trk-step.is-done .trk-step__check { display: block; }
  .trk-step.is-current .trk-step__dot { box-shadow: 0 0 0 5px var(--paper), 0 0 0 6px var(--copper); }
  .trk-step__label { color: color-mix(in srgb, var(--fg) 70%, transparent); }
  .trk-step.is-done .trk-step__label, .trk-step.is-current .trk-step__label { color: var(--fg); }
  .trk-conn { flex: 1; padding-top: 21px; min-width: 24px; }
  .trk-conn i { display: block; height: 1px; background: color-mix(in srgb, var(--fg) 20%, transparent); position: relative; overflow: hidden; }
  .trk-conn i::after { content: ''; position: absolute; inset: 0; background: var(--navy-deep); transform: scaleX(0); transform-origin: left; transition: transform 1s var(--ease-out); }
  .trk-conn.is-filled i::after { transform: scaleX(1); }
  .trk-steps[data-blocked='true'] .trk-step__dot { border-style: dashed; }

  .trk-cols { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(28px, 4vw, 72px); padding-top: clamp(28px, 3.4vw, 48px); }
  .trk-h { display: flex; align-items: center; gap: 10px; font-family: var(--f-serif); font-weight: 300; font-size: clamp(22px, 1.8vw, 30px); letter-spacing: -.01em; margin-bottom: 14px; }
  .trk-details { display: grid; }
  .trk-details :global(.trk-row) { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding: 11px 0; border-bottom: 1px solid color-mix(in srgb, var(--fg) 10%, transparent); }
  .trk-details :global(.trk-row dt) { color: color-mix(in srgb, var(--fg) 60%, transparent); flex: none; }
  .trk-details :global(.trk-row dd) { margin: 0; text-align: right; font-size: 15px; }
  .trk-details :global(.trk-gap) { height: 18px; }
  .trk-side { display: grid; gap: 36px; align-content: start; }
  .trk-block { display: grid; gap: 12px; justify-items: start; }
  .trk-badge { display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 7px; border-radius: 999px; background: var(--navy-deep); color: #fff; font-family: var(--f-sans); font-size: 12px; }
  .trk-proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; width: 100%; }
  .trk-proof:empty { display: none; }
  .trk-proof :global(.trk-shot) { display: block; aspect-ratio: 1; overflow: hidden; border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent); background: var(--ivory); }
  .trk-proof :global(.trk-shot img) { width: 100%; height: 100%; object-fit: cover; }
  .trk-link { display: inline-flex; align-items: center; gap: 8px; color: var(--accent); }
  .trk-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .trk-actions .btn[disabled] { opacity: .6; cursor: progress; }
  .trk-error { color: #b3261e; }

  @media (max-width: 860px) {
    .trk-top { align-items: start; }
    .trk-status { max-width: none; width: 100%; }
    .trk-cols { grid-template-columns: 1fr; }
    .trk-step { width: 74px; }
    .trk__card { padding: 28px 20px; }
    .trk__card::before { inset: 6px; }
  }
  @media print {
    :global(body > *:not([data-barba='wrapper'])), :global(.ftr), .trk__fan, .trk-actions, .trk-link, .trk__intro { display: none !important; }
    .trk { padding-top: 0; min-height: 0; background: #fff; }
    .trk__card { border: 0; padding: 0; }
    .trk__card::before { display: none; }
  }
</style>
